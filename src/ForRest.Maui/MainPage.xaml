<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ForRest.Maui.Controls"
             x:Class="ForRest.Maui.MainPage">

    <Grid Padding="8"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="4">
        <Border Style="{StaticResource ToolbarBorderStyle}">
            <Grid ColumnDefinitions="Auto,108,92,*,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="6">
                <Button Text="Nav"
                        Style="{StaticResource SubtleToolbarButtonStyle}"
                        Clicked="OnToggleLeftPaneClicked" />

                <Border Grid.Column="1"
                        Style="{StaticResource ToolbarFieldBorderStyle}">
                    <Picker ItemsSource="{Binding EnvironmentOptions}"
                            SelectedItem="{Binding SelectedEnvironment}" />
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource ToolbarFieldBorderStyle}">
                    <Picker ItemsSource="{Binding MethodOptions}"
                            SelectedItem="{Binding SelectedMethod}" />
                </Border>

                <Border Grid.Column="3"
                        Style="{StaticResource ToolbarFieldBorderStyle}">
                    <Entry Placeholder="https://{base_url}/..."
                           Text="{Binding RequestTarget}" />
                </Border>

                <Button Grid.Column="4"
                        Text="Send"
                        Style="{StaticResource PrimaryToolbarButtonStyle}" />

                <Button Grid.Column="5"
                        Text="Save"
                        Style="{StaticResource SubtleToolbarButtonStyle}" />

                <Button Grid.Column="6"
                        Text="Format"
                        Style="{StaticResource SubtleToolbarButtonStyle}" />

                <Button Grid.Column="7"
                        Text="Output"
                        Style="{StaticResource SubtleToolbarButtonStyle}"
                        Clicked="OnToggleRightPaneClicked" />

                <Label Grid.Column="8"
                       Text="{Binding WorkspaceBadge}"
                       VerticalTextAlignment="Center"
                       Style="{StaticResource MonoMetaStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              x:Name="WorkbenchHost"
              SizeChanged="OnWorkbenchHostSizeChanged">
            <Grid x:Name="WorkbenchGrid"
                  ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding LeftPaneWidth}" />
                    <ColumnDefinition Width="{Binding LeftSplitterWidth}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Binding RightSplitterWidth}" />
                    <ColumnDefinition Width="{Binding RightPaneWidth}" />
                </Grid.ColumnDefinitions>

                <controls:ExplorerPane Grid.Column="0"
                                       IsVisible="{Binding IsLeftPaneVisible}" />

                <BoxView Grid.Column="1"
                         IsVisible="{Binding IsLeftPaneVisible}"
                         Color="{AppThemeBinding Light={StaticResource SplitterLight}, Dark={StaticResource SplitterDark}}">
                    <BoxView.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="OnLeftSplitterPanUpdated" />
                    </BoxView.GestureRecognizers>
                </BoxView>

                <controls:WorkbenchCenterPane Grid.Column="2"
                                              Margin="6,0" />

                <BoxView Grid.Column="3"
                         IsVisible="{Binding IsRightPaneVisible}"
                         Color="{AppThemeBinding Light={StaticResource SplitterLight}, Dark={StaticResource SplitterDark}}">
                    <BoxView.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="OnRightSplitterPanUpdated" />
                    </BoxView.GestureRecognizers>
                </BoxView>

                <controls:InspectorPane Grid.Column="4"
                                        IsVisible="{Binding IsRightPaneVisible}" />
            </Grid>

            <Grid IsVisible="{Binding IsOverlayBackdropVisible}"
                  BackgroundColor="#220F172A"
                  ZIndex="5">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOverlayBackdropTapped" />
                </Grid.GestureRecognizers>
            </Grid>

            <controls:ExplorerPane IsVisible="{Binding IsExplorerOverlayVisible}"
                                   WidthRequest="{Binding CompactPaneWidth}"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Fill"
                                   ZIndex="6" />

            <controls:InspectorPane IsVisible="{Binding IsInspectorOverlayVisible}"
                                    WidthRequest="{Binding CompactPaneWidth}"
                                    HorizontalOptions="End"
                                    VerticalOptions="Fill"
                                    ZIndex="6" />
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource ChromeBorderStyle}">
            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="12">
                <Label Text="{Binding RequestStateStatus}"
                       Style="{StaticResource PaneMetaStyle}" />
                <Label Grid.Column="1"
                       Text="{Binding OpenTabsStatus}"
                       Style="{StaticResource PaneMetaStyle}" />
                <Label Grid.Column="2"
                       Text="{Binding TimingStatus}"
                       Style="{StaticResource PaneMetaStyle}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
