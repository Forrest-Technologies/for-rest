<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ForRest.Maui.Controls"
             x:Class="ForRest.Maui.MainPage">

    <Grid Padding="0"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="0">
        <Border IsVisible="{Binding IsStatusBannerVisible}"
                BackgroundColor="{Binding StatusBannerBackgroundColor}"
                Stroke="{Binding StatusBannerBorderColor}"
                StrokeThickness="1"
                Padding="12,10"
                Margin="10,10,10,0">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding StatusBannerTitle}"
                           FontAttributes="Bold"
                           TextColor="{Binding StatusBannerTextColor}" />
                    <Label Text="{Binding StatusBannerDetail}"
                           LineBreakMode="WordWrap"
                           TextColor="{Binding StatusBannerTextColor}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="✕"
                        Clicked="OnDismissStatusBannerClicked"
                        Padding="8,2"
                        VerticalOptions="Start"
                        HorizontalOptions="End" />
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              x:Name="WorkbenchHost"
              SizeChanged="OnWorkbenchHostSizeChanged">
            <Grid x:Name="WorkbenchGrid"
                  ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding LeftRestoreRailWidth}" />
                    <ColumnDefinition Width="{Binding LeftPaneWidth}" />
                    <ColumnDefinition Width="{Binding LeftSplitterWidth}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Binding RightSplitterWidth}" />
                    <ColumnDefinition Width="{Binding RightPaneWidth}" />
                    <ColumnDefinition Width="{Binding RightRestoreRailWidth}" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        IsVisible="{Binding ShowLeftPaneRestoreButton}"
                        Style="{StaticResource CollapsedPaneRailBorderStyle}">
                    <Button Text="Explorer"
                            Clicked="OnToggleLeftPaneClicked"
                            VerticalOptions="Start"
                            HorizontalOptions="Fill"
                            Style="{StaticResource CollapsedPaneRestoreButtonStyle}" />
                </Border>

                <controls:ExplorerPane Grid.Column="1"
                                       IsVisible="{Binding IsLeftPaneVisible}" />

                <Grid Grid.Column="2"
                      x:Name="LeftSplitterLane"
                      IsVisible="{Binding IsLeftPaneVisible}"
                      BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="OnLeftSplitterPanUpdated" />
                    </Grid.GestureRecognizers>
                    <BoxView x:Name="LeftSplitterLine"
                             WidthRequest="2"
                             HorizontalOptions="Center"
                             VerticalOptions="Fill"
                             Opacity="0.72"
                             Color="{DynamicResource ThemeSplitterColor}" />
                </Grid>

                <controls:WorkbenchCenterPane x:Name="CenterPane"
                                              Grid.Column="3" />

                <Grid Grid.Column="4"
                      x:Name="RightSplitterLane"
                      IsVisible="{Binding IsRightPaneVisible}"
                      BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="OnRightSplitterPanUpdated" />
                    </Grid.GestureRecognizers>
                    <BoxView x:Name="RightSplitterLine"
                             WidthRequest="2"
                             HorizontalOptions="Center"
                             VerticalOptions="Fill"
                             Opacity="0.72"
                             Color="{DynamicResource ThemeSplitterColor}" />
                </Grid>

                <controls:InspectorPane Grid.Column="5"
                                        IsVisible="{Binding IsRightPaneVisible}" />

                <Border Grid.Column="6"
                        IsVisible="{Binding ShowRightPaneRestoreButton}"
                        Style="{StaticResource CollapsedPaneRailBorderStyle}">
                    <Button Text="Inspect"
                            Clicked="OnToggleRightPaneClicked"
                            VerticalOptions="Start"
                            HorizontalOptions="Fill"
                            Style="{StaticResource CollapsedPaneRestoreButtonStyle}" />
                </Border>
            </Grid>

            <Grid IsVisible="{Binding IsOverlayBackdropVisible}"
                  BackgroundColor="{DynamicResource ThemeOverlayBackdropColor}"
                  ZIndex="5">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOverlayBackdropTapped" />
                </Grid.GestureRecognizers>
            </Grid>

            <controls:ExplorerPane IsVisible="{Binding IsExplorerOverlayVisible}"
                                   WidthRequest="{Binding CompactPaneWidth}"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Fill"
                                   ZIndex="6" />

            <controls:InspectorPane IsVisible="{Binding IsInspectorOverlayVisible}"
                                    WidthRequest="{Binding CompactPaneWidth}"
                                    HorizontalOptions="End"
                                    VerticalOptions="Fill"
                                    ZIndex="6" />

        </Grid>

        <Border Grid.Row="2"
                Margin="{OnPlatform Android='10,6,10,10', Default='0'}"
                StrokeShape="{OnPlatform Android='RoundRectangle 16', Default='RoundRectangle 0'}"
                Style="{StaticResource StatusBarBorderStyle}">
            <Grid>
                <Grid IsVisible="{Binding ShowDesktopStatusBar}"
                      ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                      ColumnSpacing="10">
                    <Label Text="{Binding ExecutionStatus}"
                           Style="{StaticResource StatusBarTextStyle}" />
                    <Label Grid.Column="1"
                           Text="{Binding ActivationStatus}"
                           Style="{StaticResource StatusBarTextStyle}" />
                    <Label Grid.Column="2"
                           Text="{Binding ResponseState}"
                           Style="{StaticResource StatusBarTextStyle}" />
                    <Label Grid.Column="3"
                           Text="{Binding ResponseTimeStatus}"
                           Style="{StaticResource StatusBarTextStyle}" />
                    <Label Grid.Column="4"
                           Text="{Binding ResponseSizeStatus}"
                           Style="{StaticResource StatusBarTextStyle}" />
                </Grid>

                <VerticalStackLayout IsVisible="{Binding ShowCompactStatusBar}"
                                     Spacing="8">
                    <Grid IsVisible="{Binding ShowCompactActionBar}"
                          ColumnDefinitions="Auto,Auto,*"
                          ColumnSpacing="8">
                        <Button Text="{Binding CompactLeftPaneButtonText}"
                                Clicked="OnToggleLeftPaneClicked"
                                Style="{StaticResource MobileFooterButtonStyle}" />
                        <Button Grid.Column="1"
                                Text="{Binding CompactRightPaneButtonText}"
                                Clicked="OnToggleRightPaneClicked"
                                Style="{StaticResource MobileFooterButtonStyle}" />
                        <Label Grid.Column="2"
                               Text="{Binding RequestStateStatus}"
                               LineBreakMode="TailTruncation"
                               VerticalTextAlignment="Center"
                               HorizontalTextAlignment="End"
                               Margin="8,0,4,0"
                               Style="{StaticResource StatusBarTextStyle}" />
                    </Grid>

                    <BoxView IsVisible="{Binding ShowCompactActionBar}"
                             HeightRequest="1"
                             HorizontalOptions="Fill"
                             Color="{DynamicResource ThemeDividerColor}"
                             Opacity="0.35" />

                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="*,Auto,Auto"
                          RowSpacing="2"
                          ColumnSpacing="10">
                        <Label Grid.ColumnSpan="3"
                               Text="{Binding ExecutionStatus}"
                               LineBreakMode="TailTruncation"
                               Style="{StaticResource StatusBarTextStyle}" />
                        <Label Grid.Row="1"
                               Text="{Binding ResponseState}"
                               LineBreakMode="TailTruncation"
                               Style="{StaticResource StatusBarTextStyle}" />
                        <Label Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding ResponseTimeStatus}"
                               Style="{StaticResource StatusBarTextStyle}" />
                        <Label Grid.Row="1"
                               Grid.Column="2"
                               Text="{Binding ResponseSizeStatus}"
                               Style="{StaticResource StatusBarTextStyle}" />
                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
