<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeCanvasColor}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource ThemeTextPrimaryColor}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource ThemeBorderColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSurfaceColor}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinimumHeightRequest" Value="28" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSurfaceMutedColor}" />
        <Setter Property="BorderColor" Value="{DynamicResource ThemeBorderColor}" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeTextPrimaryColor}" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeTextPrimaryColor}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ThemeTextMutedColor}" />
        <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeTextPrimaryColor}" />
        <Setter Property="TitleColor" Value="{DynamicResource ThemeTextMutedColor}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeTextPrimaryColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeEditorBackgroundColor}" />
    </Style>

    <Style x:Key="ChromeBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSurfaceRaisedColor}" />
        <Setter Property="Stroke" Value="{DynamicResource ThemeDividerColor}" />
    </Style>

    <Style x:Key="ToolbarBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="2,2" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSurfaceRaisedColor}" />
        <Setter Property="Stroke" Value="{DynamicResource ThemeDividerColor}" />
    </Style>

    <Style x:Key="ToolbarFieldBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSurfaceColor}" />
        <Setter Property="Stroke" Value="{DynamicResource ThemeBorderColor}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style x:Key="StatusBarBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="2,2" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeStatusBackgroundColor}" />
        <Setter Property="Stroke" Value="{DynamicResource ThemeStatusBorderColor}" />
    </Style>

    <Style x:Key="CompactToolbarEntryStyle" TargetType="Entry">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="MinimumHeightRequest" Value="28" />
        <Setter Property="HeightRequest" Value="28" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeTextPrimaryColor}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ThemeTextMutedColor}" />
        <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
    </Style>

    <Style x:Key="PaneBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSurfaceColor}" />
        <Setter Property="Stroke" Value="{DynamicResource ThemeBorderColor}" />
    </Style>

    <Style x:Key="SectionBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSurfaceColor}" />
        <Setter Property="Stroke" Value="{DynamicResource ThemeDividerColor}" />
    </Style>

    <Style x:Key="NavigationRowBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="Margin" Value="12,0,12,0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
    </Style>

    <Style x:Key="DenseTabButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="MinimumHeightRequest" Value="28" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeTextSecondaryColor}" />
    </Style>

    <Style x:Key="DocumentTabButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinimumHeightRequest" Value="30" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSurfaceMutedColor}" />
        <Setter Property="BorderColor" Value="{DynamicResource ThemeBorderColor}" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeTextSecondaryColor}" />
    </Style>

    <Style x:Key="SubtleToolbarButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="MinimumHeightRequest" Value="28" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSurfaceMutedColor}" />
        <Setter Property="BorderColor" Value="{DynamicResource ThemeBorderColor}" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeTextPrimaryColor}" />
    </Style>

    <Style x:Key="PrimaryToolbarButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="MinimumHeightRequest" Value="28" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeAccentColor}" />
        <Setter Property="BorderColor" Value="{DynamicResource ThemeAccentColor}" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeAccentTextColor}" />
    </Style>

    <Style x:Key="CompactToolbarButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="MinimumHeightRequest" Value="24" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeAccentColor}" />
        <Setter Property="BorderColor" Value="{DynamicResource ThemeAccentColor}" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeAccentTextColor}" />
    </Style>

    <Style x:Key="PaneTitleStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeTextPrimaryColor}" />
    </Style>

    <Style x:Key="EditorDocumentTitleStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeTextPrimaryColor}" />
    </Style>

    <Style x:Key="PaneMetaStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeTextSecondaryColor}" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeTextSecondaryColor}" />
    </Style>

    <Style x:Key="BrandLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CharacterSpacing" Value="1.6" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeTextPrimaryColor}" />
    </Style>

    <Style x:Key="MonoTextStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeTextPrimaryColor}" />
    </Style>

    <Style x:Key="MonoMetaStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeTextMutedColor}" />
    </Style>

    <Style x:Key="ToolbarMethodLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeAccentStrongColor}" />
    </Style>

    <Style x:Key="MetricValueStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeTextPrimaryColor}" />
    </Style>

    <Style x:Key="StatusBarTextStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeStatusTextColor}" />
    </Style>
</ResourceDictionary>
