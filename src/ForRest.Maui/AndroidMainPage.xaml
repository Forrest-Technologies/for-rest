<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ForRest.Maui.AndroidMainPage">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,*"
          RowSpacing="0">
        <Border IsVisible="{Binding IsStatusBannerVisible}"
                BackgroundColor="{Binding StatusBannerBackgroundColor}"
                Stroke="{Binding StatusBannerBorderColor}"
                StrokeThickness="1"
                Padding="12,10"
                Margin="8,8,8,0">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding StatusBannerTitle}"
                           FontAttributes="Bold"
                           TextColor="{Binding StatusBannerTextColor}" />
                    <Label Text="{Binding StatusBannerDetail}"
                           LineBreakMode="WordWrap"
                           TextColor="{Binding StatusBannerTextColor}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="✕"
                        Clicked="OnDismissStatusBannerClicked"
                        Padding="8,2"
                        VerticalOptions="Start"
                        HorizontalOptions="End" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource ChromeBorderStyle}">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="FOR-REST"
                           Style="{StaticResource BrandLabelStyle}" />
                    <Label Text="{Binding RequestStateStatus}"
                           Style="{StaticResource PaneMetaStyle}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1"
                                     HorizontalOptions="End"
                                     Spacing="2">
                    <Label Text="{Binding SelectedWorkspace}"
                           HorizontalTextAlignment="End"
                           Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="{Binding SelectedEnvironment}"
                           HorizontalTextAlignment="End"
                           Style="{StaticResource MonoMetaStyle}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource ToolbarBorderStyle}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*"
                  ColumnSpacing="6">
                <Button Text="Run"
                        Style="{StaticResource PrimaryToolbarButtonStyle}"
                        Clicked="OnSendClicked"
                        IsEnabled="{Binding CanSend}" />
                <Button Grid.Column="1"
                        Text="Copy"
                        Style="{StaticResource SubtleToolbarButtonStyle}"
                        Clicked="OnCopyRequestClicked" />
                <Button Grid.Column="2"
                        Text="&#x2726; Ask"
                        Style="{StaticResource SubtleToolbarButtonStyle}"
                        Clicked="OnOpenWorkspaceAssistantClicked"
                        SemanticProperties.Description="Open the workspace assistant" />
                <Label Grid.Column="3"
                       Text="{Binding ExecutionStatus}"
                       VerticalTextAlignment="Center"
                       LineBreakMode="TailTruncation"
                       Style="{StaticResource StatusBarTextStyle}" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Style="{StaticResource SectionBorderStyle}">
            <Grid RowDefinitions="Auto,*">
                <Grid Padding="12,8"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="10">
                    <Label Text="Request"
                           Style="{StaticResource SectionTitleStyle}" />
                    <Label Grid.Column="1"
                           Text="{Binding ActiveEditorLanguage}"
                           Style="{StaticResource MonoMetaStyle}" />
                </Grid>

                <Editor x:Name="RequestEditor"
                        Grid.Row="1"
                        Text="{Binding ActiveEditorPresentationText, Mode=TwoWay}"
                        Focused="OnRequestEditorFocused"
                        Unfocused="OnRequestEditorUnfocused"
                        AutoSize="Disabled"
                        Margin="0"
                        FontFamily="OpenSansRegular"
                        FontSize="{Binding ActiveEditorFontSize}"
                        TextColor="{DynamicResource ThemeTextPrimaryColor}"
                        BackgroundColor="{DynamicResource ThemeEditorBackgroundColor}"
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        Keyboard="Text" />
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Style="{StaticResource StatusBarBorderStyle}">
            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,Auto,Auto,*"
                  RowSpacing="6"
                  ColumnSpacing="6">
                <Button x:Name="ResponseTabButton"
                        Text="Response"
                        FontSize="{Binding ResultPaneTabFontSize}"
                        Style="{StaticResource DenseTabButtonStyle}"
                        Clicked="OnShowResponseClicked" />
                <Button x:Name="RawTabButton"
                        Grid.Column="1"
                        Text="Raw"
                        FontSize="{Binding ResultPaneTabFontSize}"
                        Style="{StaticResource DenseTabButtonStyle}"
                        Clicked="OnShowRawClicked" />
                <Button x:Name="DebugTabButton"
                        Grid.Column="2"
                        Text="Debug"
                        FontSize="{Binding ResultPaneTabFontSize}"
                        Style="{StaticResource DenseTabButtonStyle}"
                        Clicked="OnShowDebugClicked" />
                <Label Grid.Column="3"
                       Text="{Binding ResponseState}"
                       VerticalTextAlignment="Center"
                       LineBreakMode="TailTruncation"
                       Style="{StaticResource StatusBarTextStyle}" />

                <Button Grid.Row="1"
                        Text="Copy Output"
                        Style="{StaticResource SubtleToolbarButtonStyle}"
                        Clicked="OnCopyOutputClicked" />
                <Button Grid.Row="1"
                        Grid.Column="3"
                        Text="Select All"
                        Style="{StaticResource SubtleToolbarButtonStyle}"
                        Clicked="OnSelectAllOutputClicked"
                        HorizontalOptions="End" />
                <Button x:Name="HtmlPreviewButton"
                        Grid.Row="1"
                        Grid.Column="3"
                        Text="{Binding HtmlPreviewButtonText}"
                        Style="{StaticResource DenseTabButtonStyle}"
                        Clicked="OnToggleHtmlPreviewClicked"
                        IsVisible="{Binding IsRenderableResponse}"
                        HorizontalOptions="End"
                        Margin="0,0,80,0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowRenderedResponse}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSelectionSoftColor}" />
                            <Setter Property="BorderColor" Value="{DynamicResource ThemeSelectionBorderColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource ThemeSelectionTextColor}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button x:Name="ResponsePrettyPrintButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Text="{Binding ResponsePrettyPrintButtonText}"
                        Style="{StaticResource DenseTabButtonStyle}"
                        Clicked="OnTogglePrettyPrintClicked" />
                <Button x:Name="CopyDebugSummaryButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Text="Copy Summary"
                        Style="{StaticResource SubtleToolbarButtonStyle}"
                        Clicked="OnCopyDebugSummaryClicked"
                        IsEnabled="{Binding CanCopyDebugSummary}"
                        IsVisible="False" />
                <Label Grid.Row="1"
                       Grid.Column="3"
                       Text="{Binding ExecutionStatus}"
                       VerticalTextAlignment="Center"
                       LineBreakMode="TailTruncation"
                       Style="{StaticResource StatusBarTextStyle}" />
            </Grid>
        </Border>

        <Border Grid.Row="5"
                Style="{StaticResource SectionBorderStyle}">
            <Grid RowDefinitions="Auto,*">
                <Grid Padding="12,8"
                      ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="10">
                    <Label x:Name="OutputTitleLabel"
                           Text="Response"
                           Style="{StaticResource SectionTitleStyle}" />
                    <Label Grid.Column="1"
                           Text="{Binding ResponseTimeStatus}"
                           Style="{StaticResource MonoMetaStyle}" />
                    <Label Grid.Column="2"
                           Text="{Binding ResponseSizeStatus}"
                           Style="{StaticResource MonoMetaStyle}" />
                </Grid>

                <ContentView x:Name="ResponseOutputHost"
                             Grid.Row="1" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
