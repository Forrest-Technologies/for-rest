<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ForRest.Maui.Controls.ExplorerPane">

    <Border Style="{StaticResource PaneBorderStyle}">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
            <Grid Padding="10,8,10,6"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <VerticalStackLayout Spacing="0">
                    <Label Text="Workspace" Style="{StaticResource PaneTitleStyle}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="Hide"
                        Style="{StaticResource SubtleToolbarButtonStyle}"
                        Clicked="OnHideClicked" />
            </Grid>

            <Grid Grid.Row="1">
                <ScrollView Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Padding="10,0,10,8"
                                           Spacing="4"
                                           BindableLayout.ItemsSource="{Binding LeftPaneTabs}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Button Text="{Binding Title}"
                                        Style="{StaticResource DenseTabButtonStyle}"
                                        Clicked="OnTabClicked"
                                        CommandParameter="{Binding .}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSelectionSoftColor}" />
                                            <Setter Property="BorderColor" Value="{DynamicResource ThemeSelectionBorderColor}" />
                                            <Setter Property="TextColor" Value="{DynamicResource ThemeSelectionTextColor}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
            </Grid>

            <Grid Grid.Row="2"
                  Padding="10,0,10,8"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8">
                <Label Text="ROOT"
                       VerticalTextAlignment="Start"
                       Style="{StaticResource MonoMetaStyle}" />
                <ScrollView Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="6"
                                           BindableLayout.ItemsSource="{Binding Workspaces}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Button Text="{Binding Title}"
                                        Style="{StaticResource DenseTabButtonStyle}"
                                        Clicked="OnWorkspaceClicked"
                                        CommandParameter="{Binding .}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSelectionSoftColor}" />
                                            <Setter Property="BorderColor" Value="{DynamicResource ThemeSelectionBorderColor}" />
                                            <Setter Property="TextColor" Value="{DynamicResource ThemeSelectionTextColor}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
                <Button Grid.Column="2"
                        Text="+"
                        Style="{StaticResource DenseTabButtonStyle}"
                        Clicked="OnAddWorkspaceClicked" />
            </Grid>

            <Grid Grid.Row="3">
                <ScrollView IsVisible="{Binding IsExplorerTabVisible}">
                    <VerticalStackLayout Padding="0,0,0,12"
                                         Spacing="10"
                                         BindableLayout.ItemsSource="{Binding ExplorerSections}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="2">
                                    <Grid Margin="12,6,12,4"
                                          ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <Label Text="{Binding Title}"
                                               Style="{StaticResource SectionTitleStyle}" />
                                        <Button Grid.Column="1"
                                                Text="+ Request"
                                                IsVisible="False"
                                                Style="{StaticResource DenseTabButtonStyle}"
                                                Clicked="OnAddRequestClicked">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding Title}" Value="Requests">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </Grid>
                                    <VerticalStackLayout Spacing="0"
                                                         BindableLayout.ItemsSource="{Binding Items}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource NavigationRowBorderStyle}"
                                                        Margin="{Binding Indent}">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnItemTapped"
                                                                              CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                                          ColumnSpacing="8">
                                                        <Label Text="{Binding Kind}"
                                                               TextColor="{Binding AccentColor}"
                                                               Style="{StaticResource MonoMetaStyle}" />
                                                        <VerticalStackLayout Grid.Column="1"
                                                                             Spacing="1">
                                                            <Label Text="{Binding Title}"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="12"
                                                                   LineBreakMode="TailTruncation" />
                                                            <Label Text="{Binding Detail}"
                                                                   Style="{StaticResource PaneMetaStyle}"
                                                                   LineBreakMode="TailTruncation" />
                                                        </VerticalStackLayout>
                                                        <Label Grid.Column="2"
                                                               Text="{Binding Context}"
                                                               HorizontalTextAlignment="End"
                                                               LineBreakMode="TailTruncation"
                                                               Style="{StaticResource MonoMetaStyle}" />
                                                    </Grid>
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSelectionStrongColor}" />
                                                            <Setter Property="Stroke" Value="{DynamicResource ThemeSelectionBorderColor}" />
                                                            <Setter Property="StrokeThickness" Value="1" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>

                <ScrollView IsVisible="{Binding IsHistoryTabVisible}">
                    <VerticalStackLayout Padding="0,6,0,12"
                                         Spacing="0"
                                         BindableLayout.ItemsSource="{Binding HistoryItems}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource NavigationRowBorderStyle}">
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="8">
                                        <Label Text="{Binding Method}"
                                               TextColor="{Binding AccentColor}"
                                               Style="{StaticResource MonoMetaStyle}" />
                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="1">
                                            <Label Text="{Binding Title}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="12" />
                                            <Label Text="{Binding Summary}"
                                                   Style="{StaticResource PaneMetaStyle}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               Text="{Binding When}"
                                               Style="{StaticResource MonoMetaStyle}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>
    </Border>
</ContentView>
