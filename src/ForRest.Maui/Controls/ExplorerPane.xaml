<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ForRest.Maui.Controls.ExplorerPane"
             x:Name="ExplorerRoot">

    <Border Style="{StaticResource PaneBorderStyle}">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
            <Grid Padding="10,8,10,6"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <VerticalStackLayout Spacing="0">
                    <Label Text="Workspace" Style="{StaticResource PaneTitleStyle}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="Hide"
                        Style="{StaticResource SubtleToolbarButtonStyle}"
                        Clicked="OnHideClicked" />
            </Grid>

            <Grid Grid.Row="1">
                <ScrollView Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Padding="10,0,10,8"
                                           Spacing="4"
                                           BindableLayout.ItemsSource="{Binding LeftPaneTabs}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Button Text="{Binding Title}"
                                        Style="{StaticResource DenseTabButtonStyle}"
                                        Clicked="OnTabClicked"
                                        CommandParameter="{Binding .}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSelectionSoftColor}" />
                                            <Setter Property="BorderColor" Value="{DynamicResource ThemeSelectionBorderColor}" />
                                            <Setter Property="TextColor" Value="{DynamicResource ThemeSelectionTextColor}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
            </Grid>

            <Grid Grid.Row="2"
                  Padding="10,0,10,8"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8">
                <Label Text="WORKSPACES"
                       VerticalTextAlignment="Start"
                       Style="{StaticResource MonoMetaStyle}" />
                <ScrollView Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="6"
                                           BindableLayout.ItemsSource="{Binding Workspaces}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Button Text="{Binding Title}"
                                        Style="{StaticResource DenseTabButtonStyle}"
                                        Clicked="OnWorkspaceClicked"
                                        CommandParameter="{Binding .}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSelectionSoftColor}" />
                                            <Setter Property="BorderColor" Value="{DynamicResource ThemeSelectionBorderColor}" />
                                            <Setter Property="TextColor" Value="{DynamicResource ThemeSelectionTextColor}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
                <HorizontalStackLayout Grid.Column="2"
                                       Spacing="4">
                    <Button Text="&lt;"
                            Style="{StaticResource DenseTabButtonStyle}"
                            Clicked="OnMoveWorkspaceLeftClicked"
                            SemanticProperties.Description="Move selected workspace left"
                            IsEnabled="{Binding CanMoveWorkspaceLeft}" />
                    <Button Text="&gt;"
                            Style="{StaticResource DenseTabButtonStyle}"
                            Clicked="OnMoveWorkspaceRightClicked"
                            SemanticProperties.Description="Move selected workspace right"
                            IsEnabled="{Binding CanMoveWorkspaceRight}" />
                    <Button Text="+"
                            Style="{StaticResource DenseTabButtonStyle}"
                            Clicked="OnAddWorkspaceClicked"
                            SemanticProperties.Description="Add workspace" />
                </HorizontalStackLayout>
            </Grid>

            <Grid Grid.Row="3">
                <ScrollView IsVisible="{Binding IsExplorerTabVisible}">
                    <VerticalStackLayout Padding="0,0,0,12"
                                         Spacing="10"
                                         BindableLayout.ItemsSource="{Binding ExplorerSections}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="2">
                                    <Grid Margin="12,6,12,4"
                                          ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="0">
                                            <Label Text="{Binding Title}"
                                                   Style="{StaticResource SectionTitleStyle}" />
                                            <Label Text="{Binding Subtitle}"
                                                   Style="{StaticResource MonoMetaStyle}" />
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="1"
                                                               Spacing="4"
                                                               IsVisible="{Binding SupportsRequestActions}">
                                            <Button Text="^"
                                                    Style="{StaticResource DenseTabButtonStyle}"
                                                    Clicked="OnMoveRequestUpClicked"
                                                    SemanticProperties.Description="Move selected file up"
                                                    IsEnabled="{Binding BindingContext.CanMoveRequestUp, Source={x:Reference ExplorerRoot}}" />
                                            <Button Text="v"
                                                    Style="{StaticResource DenseTabButtonStyle}"
                                                    Clicked="OnMoveRequestDownClicked"
                                                    SemanticProperties.Description="Move selected file down"
                                                    IsEnabled="{Binding BindingContext.CanMoveRequestDown, Source={x:Reference ExplorerRoot}}" />
                                            <Button Text="+"
                                                    Style="{StaticResource DenseTabButtonStyle}"
                                                    Clicked="OnAddRequestClicked"
                                                    SemanticProperties.Description="Add request or script file" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <VerticalStackLayout Spacing="0"
                                                         BindableLayout.ItemsSource="{Binding Items}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource NavigationRowBorderStyle}"
                                                        Margin="{Binding Indent}">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnItemTapped"
                                                                              CommandParameter="{Binding .}" />
                                                        </Border.GestureRecognizers>
                                                    <Grid ColumnDefinitions="Auto,*"
                                                          ColumnSpacing="10">
                                                        <Label Text="{Binding Kind}"
                                                               TextColor="{Binding AccentColor}"
                                                               Style="{StaticResource MonoMetaStyle}"
                                                               VerticalTextAlignment="Start" />
                                                        <VerticalStackLayout Grid.Column="1"
                                                                             Spacing="2">
                                                            <Label Text="{Binding Title}"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="12"
                                                                   LineBreakMode="TailTruncation" />
                                                            <Label Text="{Binding Detail}"
                                                                   Style="{StaticResource PaneMetaStyle}"
                                                                   LineBreakMode="TailTruncation" />
                                                            <Label Text="{Binding ContextDisplay}"
                                                               LineBreakMode="TailTruncation"
                                                               Style="{StaticResource MonoMetaStyle}" />
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSelectionStrongColor}" />
                                                            <Setter Property="Stroke" Value="{DynamicResource ThemeSelectionBorderColor}" />
                                                            <Setter Property="StrokeThickness" Value="1" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>

                <ScrollView IsVisible="{Binding IsHistoryTabVisible}">
                    <VerticalStackLayout Padding="0,6,0,12"
                                         Spacing="0"
                                         BindableLayout.ItemsSource="{Binding HistoryItems}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource NavigationRowBorderStyle}">
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="8">
                                        <Label Text="{Binding Method}"
                                               TextColor="{Binding AccentColor}"
                                               Style="{StaticResource MonoMetaStyle}" />
                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="1">
                                            <Label Text="{Binding Title}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="12" />
                                            <Label Text="{Binding Summary}"
                                                   Style="{StaticResource PaneMetaStyle}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               Text="{Binding When}"
                                               Style="{StaticResource MonoMetaStyle}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>
    </Border>
</ContentView>
