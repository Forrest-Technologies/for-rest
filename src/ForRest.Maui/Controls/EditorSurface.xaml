<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ForRest.Maui.Controls.EditorSurface"
             x:Name="Root">

    <Border Style="{StaticResource SectionBorderStyle}">
        <Grid RowDefinitions="Auto,*">
            <Grid Padding="10,7"
                  ColumnDefinitions="*,Auto">
                <Label Text="{Binding Title, Source={x:Reference Root}}"
                       Style="{StaticResource SectionTitleStyle}" />
                <Label Grid.Column="1"
                       Text="{Binding Language, Source={x:Reference Root}}"
                       FontSize="11"
                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
            </Grid>

            <Editor Grid.Row="1"
                    Text="{Binding Text, Source={x:Reference Root}, Mode=TwoWay}"
                    IsReadOnly="{Binding IsReadOnly, Source={x:Reference Root}}"
                    AutoSize="Disabled"
                    FontFamily="Courier New"
                    FontSize="13"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource EditorBackgroundLight}, Dark={StaticResource EditorBackgroundDark}}"
                    Margin="1"
                    HeightRequest="360"
                    IsSpellCheckEnabled="False"
                    IsTextPredictionEnabled="False"
                    Keyboard="Text" />
        </Grid>
    </Border>
</ContentView>
