<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ForRest.Maui.Controls.EditorSurface"
             x:Name="Root">

    <Border Style="{StaticResource SectionBorderStyle}" Padding="0" Margin="0">
        <Grid RowDefinitions="Auto,*">
            <Grid Padding="10,7"
                  ColumnDefinitions="*,Auto">
                <Label Text="{Binding Title, Source={x:Reference Root}}"
                       Style="{StaticResource SectionTitleStyle}" />
                <Label Grid.Column="1"
                       Text="{Binding Language, Source={x:Reference Root}}"
                       FontSize="11"
                       TextColor="{StaticResource TextMutedLight}" />
            </Grid>

            <Border Grid.Row="1"
                    Margin="1"
                    Padding="0"
                    BackgroundColor="{StaticResource EditorBackgroundLight}"
                    StrokeThickness="0">
                <Editor Text="{Binding Text, Source={x:Reference Root}, Mode=TwoWay}"
                        IsReadOnly="{Binding IsReadOnly, Source={x:Reference Root}}"
                        AutoSize="Disabled"
                        FontFamily="Courier New"
                        FontSize="13"
                        TextColor="{StaticResource TextPrimaryLight}"
                        BackgroundColor="{StaticResource EditorBackgroundLight}"
                        Margin="0"
                        HeightRequest="420" />
            </Border>
        </Grid>
    </Border>
</ContentView>
