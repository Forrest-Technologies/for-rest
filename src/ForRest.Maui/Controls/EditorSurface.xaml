<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ForRest.Maui.Controls.EditorSurface"
             x:Name="Root">

    <Border Style="{StaticResource SectionBorderStyle}">
        <Grid RowDefinitions="Auto,*,Auto">
            <Grid IsVisible="{Binding ShowHeader, Source={x:Reference Root}}"
                  Padding="12,8"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">
                <Label Text="{Binding Title, Source={x:Reference Root}}"
                       Style="{StaticResource SectionTitleStyle}" />
                <Label Grid.Column="1"
                       Text="{Binding Language, Source={x:Reference Root}}"
                       Style="{StaticResource MonoMetaStyle}" />
            </Grid>

            <!-- No line-number gutter here on purpose: a stack of labels cannot track the
                 native Editor's soft wrapping or scrolling, so the numbers drift and lie.
                 Platforms with a real code editor (Monaco/Sora) get true gutters there. -->
            <Grid Grid.Row="1"
                  MinimumHeightRequest="340">
                <Editor x:Name="TextEditor"
                        Text="{Binding Text, Source={x:Reference Root}, Mode=TwoWay}"
                        IsReadOnly="{Binding IsReadOnly, Source={x:Reference Root}}"
                        FontSize="{Binding EditorFontSize, Source={x:Reference Root}}"
                        AutoSize="Disabled"
                        Margin="0"
                        FontFamily="OpenSansRegular"
                        TextColor="{DynamicResource ThemeTextPrimaryColor}"
                        BackgroundColor="{DynamicResource ThemeEditorBackgroundColor}"
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        Keyboard="Text" />
            </Grid>

            <Grid Grid.Row="2"
                  IsVisible="{Binding ShowFooter, Source={x:Reference Root}}"
                  Padding="12,6"
                  ColumnDefinitions="*">
                <Label Text="{Binding FooterText, Source={x:Reference Root}}"
                       Style="{StaticResource PaneMetaStyle}" />
            </Grid>
        </Grid>
    </Border>
</ContentView>
