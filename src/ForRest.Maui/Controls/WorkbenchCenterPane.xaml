<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ForRest.Maui.Controls"
             x:Class="ForRest.Maui.Controls.WorkbenchCenterPane">

    <Border Style="{StaticResource PaneBorderStyle}"
            BackgroundColor="{DynamicResource ThemeEditorBackgroundColor}"
            Stroke="{DynamicResource ThemeDividerColor}">
        <Grid RowDefinitions="Auto,Auto,*">
            <Grid Padding="8,4,8,2"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="6">
                <Label Text="{Binding ActiveDocumentKindLabel}"
                       VerticalTextAlignment="Start"
                       TextColor="{Binding ActiveDocumentKindColor}"
                       Style="{StaticResource MonoMetaStyle}" />

                <Label Grid.Column="1"
                       Text="{Binding ActiveDocumentLabel}"
                       Style="{StaticResource EditorDocumentTitleStyle}" />
            </Grid>

            <Grid Grid.Row="1"
                  Padding="6,0,6,6">
                <ScrollView Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="4"
                                           BindableLayout.ItemsSource="{Binding CenterTabs}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Button Text="{Binding Title}"
                                        Style="{StaticResource DenseTabButtonStyle}"
                                        Clicked="OnTabClicked"
                                        CommandParameter="{Binding .}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSelectionSoftColor}" />
                                            <Setter Property="BorderColor" Value="{DynamicResource ThemeSelectionBorderColor}" />
                                            <Setter Property="TextColor" Value="{DynamicResource ThemeSelectionTextColor}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
            </Grid>

            <Grid Grid.Row="2"
                  Padding="0">
                <controls:MonacoEditorSurface Language="{Binding ActiveEditorLanguage}"
                                              EditableRangesJson="{Binding ActiveEditorEditableRangesJson}"
                                              SendRequested="OnEditorSendRequested"
                                              ThemeKey="{Binding EditorThemeKey}"
                                              Text="{Binding ActiveEditorText}" />
            </Grid>
        </Grid>
    </Border>
</ContentView>
