<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ForRest.Maui.Controls"
             x:Class="ForRest.Maui.Controls.WorkbenchCenterPane">

    <Border Style="{StaticResource PaneBorderStyle}">
        <Grid RowDefinitions="Auto,Auto,*">
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Padding="8,6,8,0"
                                       Spacing="4"
                                       BindableLayout.ItemsSource="{Binding OpenDocuments}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding DisplayTitle}"
                                    Style="{StaticResource DocumentTabButtonStyle}"
                                    Clicked="OnDocumentClicked"
                                    CommandParameter="{Binding .}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceLight}" />
                                        <Setter Property="BorderColor" Value="{StaticResource AccentLight}" />
                                        <Setter Property="TextColor" Value="{StaticResource TextPrimaryLight}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Padding="8,6,8,6"
                                       Spacing="4"
                                       BindableLayout.ItemsSource="{Binding CenterTabs}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding Title}"
                                    Style="{StaticResource DenseTabButtonStyle}"
                                    Clicked="OnTabClicked"
                                    CommandParameter="{Binding .}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource AccentSoftLight}" />
                                        <Setter Property="BorderColor" Value="{StaticResource BorderLight}" />
                                        <Setter Property="TextColor" Value="{StaticResource AccentStrongLight}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <Grid Grid.Row="2">
                <ScrollView IsVisible="{Binding IsRequestTabVisible}">
                    <VerticalStackLayout Padding="10,0,10,10"
                                         Spacing="8">
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <Grid ColumnDefinitions="90,*"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="10"
                                  RowSpacing="8">
                                <Label Text="Name" Style="{StaticResource SectionTitleStyle}" />
                                <Border Grid.Column="1"
                                        Style="{StaticResource InputBorderStyle}"
                                        Padding="8,3"
                                        Margin="0">
                                    <Entry Text="{Binding RequestName}" />
                                </Border>

                                <Label Grid.Row="1" Text="URL" Style="{StaticResource SectionTitleStyle}" />
                                <Border Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource InputBorderStyle}"
                                        Padding="8,3"
                                        Margin="0">
                                    <Entry Text="{Binding RequestUrl}" />
                                </Border>

                                <Label Grid.Row="2" Text="Notes" Style="{StaticResource SectionTitleStyle}" />
                                <Border Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource InputBorderStyle}"
                                        Padding="8,6"
                                        Margin="0">
                                    <Editor Text="{Binding RequestNotes}"
                                            AutoSize="TextChanges"
                                            FontFamily="OpenSansRegular"
                                            FontSize="13"
                                            BackgroundColor="Transparent"
                                            HeightRequest="80" />
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>

                <ScrollView IsVisible="{Binding IsBodyTabVisible}">
                    <VerticalStackLayout Padding="10,0,10,10">
                        <controls:EditorSurface Title="Body"
                                                Language="json"
                                                Text="{Binding BodyEditorText}" />
                    </VerticalStackLayout>
                </ScrollView>

                <ScrollView IsVisible="{Binding IsTestsTabVisible}">
                    <VerticalStackLayout Padding="10,0,10,10">
                        <controls:EditorSurface Title="Tests"
                                                Language="script"
                                                Text="{Binding TestsEditorText}" />
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>
    </Border>
</ContentView>
