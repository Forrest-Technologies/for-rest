<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ForRest.Maui.Controls"
             x:Class="ForRest.Maui.Controls.WorkbenchCenterPane">

    <Border Style="{StaticResource PaneBorderStyle}"
            BackgroundColor="{DynamicResource ThemeEditorBackgroundColor}"
            Stroke="{DynamicResource ThemeDividerColor}">
        <Grid RowDefinitions="Auto,Auto,*">
            <Grid Padding="8,4,8,2"
                  ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="6">
                <Label Text="{Binding ActiveDocumentKindLabel}"
                       VerticalTextAlignment="Start"
                       TextColor="{Binding ActiveDocumentKindColor}"
                       Style="{StaticResource MonoMetaStyle}" />

                <Label Grid.Column="1"
                       Text="{Binding ActiveDocumentLabel}"
                       Style="{StaticResource EditorDocumentTitleStyle}" />

                <Button Grid.Column="2"
                        Text="{Binding LanguageHelpToggleText}"
                        IsVisible="{Binding ShowLanguageHelpToggle}"
                        Style="{StaticResource DenseTabButtonStyle}"
                        Clicked="OnToggleLanguageHelpClicked"
                        SemanticProperties.Description="Open or close the ForRest language reference" />

                <Button Grid.Column="3"
                        Text="Undo"
                        Style="{StaticResource DenseTabButtonStyle}"
                        Clicked="OnUndoClicked"
                        IsEnabled="{Binding CanUndo}"
                        SemanticProperties.Description="Undo the latest change in the current document" />

                <Button Grid.Column="4"
                        Text="Redo"
                        Style="{StaticResource DenseTabButtonStyle}"
                        Clicked="OnRedoClicked"
                        IsEnabled="{Binding CanRedo}"
                        SemanticProperties.Description="Redo the latest undone change in the current document" />

                <Button Grid.Column="5"
                        Text="Paste"
                        Style="{StaticResource DenseTabButtonStyle}"
                        Clicked="OnPasteClicked"
                        SemanticProperties.Description="Paste clipboard text into the current document" />

                <Button Grid.Column="6"
                        Text="Copy"
                        Style="{StaticResource DenseTabButtonStyle}"
                        Clicked="OnCopyClicked"
                        SemanticProperties.Description="Copy the current editor text" />
            </Grid>

            <Border Grid.Row="1"
                    Margin="8,0,8,6"
                    Padding="8,6"
                    IsVisible="{Binding ShowEditorDebugStrip}"
                    BackgroundColor="{DynamicResource ThemeEditorBackgroundColor}"
                    Stroke="{DynamicResource ThemeDividerColor}"
                    StrokeThickness="1">
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="8"
                      RowSpacing="2">
                    <Label Text="{Binding EditorDebugStateText}"
                           TextColor="{Binding EditorDebugAccentColor}"
                           Style="{StaticResource MonoMetaStyle}" />

                    <Label Grid.Column="1"
                           Text="{Binding EditorDebugSummaryText}"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           Style="{StaticResource SectionTitleStyle}" />

                    <Label Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Text="{Binding EditorDebugDetailText}"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           Style="{StaticResource PaneMetaStyle}" />
                </Grid>
            </Border>

            <Grid Grid.Row="2"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="0"
                  Padding="0">
                <Grid Grid.Column="0">
                    <ContentView x:Name="EditorHost" />

                    <Grid HorizontalOptions="End"
                          VerticalOptions="End"
                          Margin="0,0,18,18"
                          ZIndex="10">
                        <Button Text="{Binding SendButtonText}"
                                Clicked="OnSendClicked"
                                IsEnabled="{Binding CanSend}"
                                FontSize="18"
                                Padding="0"
                                SemanticProperties.Description="Run script"
                                SemanticProperties.Hint="Runs the current request script"
                                Style="{StaticResource FloatingActionButtonStyle}" />

                        <ActivityIndicator IsRunning="{Binding IsSending}"
                                           IsVisible="{Binding IsSending}"
                                           Color="{DynamicResource ThemeAccentTextColor}"
                                           WidthRequest="24"
                                           HeightRequest="24"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           InputTransparent="True"
                                           ZIndex="11" />
                    </Grid>
                </Grid>

                <Border Grid.Column="1"
                        IsVisible="{Binding ShowInlineLanguageHelpDrawer}"
                        WidthRequest="332"
                        BackgroundColor="{DynamicResource ThemeEditorBackgroundColor}"
                        Stroke="{DynamicResource ThemeDividerColor}"
                        StrokeThickness="1">
                    <Grid Padding="10,8"
                          RowDefinitions="Auto,Auto,*,Auto"
                          RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="ForRest Language"
                                       Style="{StaticResource SectionTitleStyle}" />
                                <Label Text="Search supported syntax, helpers, and examples"
                                       Style="{StaticResource PaneMetaStyle}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Entry Grid.Row="1"
                               Text="{Binding LanguageHelpSearchText}"
                               Placeholder="Search ForRest"
                               ClearButtonVisibility="WhileEditing"
                               FontSize="13" />

                        <Grid Grid.Row="2"
                              RowDefinitions="Auto,*"
                              RowSpacing="8">
                            <CollectionView ItemsSource="{Binding LanguageHelpEntries}"
                                            SelectionMode="Single"
                                            SelectionChanged="OnLanguageHelpSelectionChanged"
                                            HeightRequest="192">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource NavigationRowBorderStyle}"
                                                Margin="0">
                                            <VerticalStackLayout Spacing="2">
                                                <Grid ColumnDefinitions="Auto,*"
                                                      ColumnSpacing="8">
                                                    <Label Text="{Binding Category}"
                                                           Style="{StaticResource MonoMetaStyle}"
                                                           VerticalTextAlignment="Start" />
                                                    <VerticalStackLayout Grid.Column="1"
                                                                         Spacing="1">
                                                        <Label Text="{Binding Title}"
                                                               FontFamily="OpenSansSemibold"
                                                               FontSize="12"
                                                               LineBreakMode="TailTruncation" />
                                                        <Label Text="{Binding Summary}"
                                                               Style="{StaticResource PaneMetaStyle}"
                                                               LineBreakMode="TailTruncation"
                                                               MaxLines="2" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <ScrollView Grid.Row="1">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding LanguageHelpEmptyStateText}"
                                           IsVisible="{Binding ShowLanguageHelpEmptyState}"
                                           Style="{StaticResource PaneMetaStyle}" />

                                    <VerticalStackLayout IsVisible="{Binding HasSelectedLanguageHelpEntry}"
                                                         Spacing="8">
                                        <VerticalStackLayout Spacing="1">
                                            <Label Text="{Binding SelectedLanguageHelpTitle}"
                                                   Style="{StaticResource SectionTitleStyle}" />
                                            <Label Text="{Binding SelectedLanguageHelpCategory}"
                                                   Style="{StaticResource MonoMetaStyle}" />
                                        </VerticalStackLayout>

                                        <Label Text="{Binding SelectedLanguageHelpSummary}"
                                               Style="{StaticResource PaneMetaStyle}" />

                                        <Label Text="{Binding SelectedLanguageHelpDocumentation}"
                                               LineBreakMode="WordWrap"
                                               Style="{StaticResource PaneMetaStyle}" />

                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="8">
                                            <Label Text="Example"
                                                   VerticalTextAlignment="Center"
                                                   Style="{StaticResource MonoMetaStyle}" />
                                            <Button Grid.Column="1"
                                                    Text="Copy"
                                                    Style="{StaticResource DenseTabButtonStyle}"
                                                    IsEnabled="{Binding CanCopyLanguageHelpExample}"
                                                    Clicked="OnCopyLanguageHelpExampleClicked"
                                                    SemanticProperties.Description="Copy the selected ForRest example" />
                                        </Grid>

                                        <Border BackgroundColor="{DynamicResource ThemeEditorBackgroundColor}"
                                                Stroke="{DynamicResource ThemeDividerColor}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 8">
                                            <ContentView x:Name="InlineLanguageHelpExampleHost"
                                                         HeightRequest="228" />
                                        </Border>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </ScrollView>
                        </Grid>

                        <Label Grid.Row="3"
                               Text="Reference is limited to syntax the compiler and runtime currently support."
                               Style="{StaticResource MonoMetaStyle}" />
                    </Grid>
                </Border>

                <Border Grid.ColumnSpan="2"
                        IsVisible="{Binding ShowCompactLanguageHelpDrawer}"
                        WidthRequest="{Binding CompactPaneWidth}"
                        HorizontalOptions="End"
                        VerticalOptions="Fill"
                        BackgroundColor="{DynamicResource ThemeEditorBackgroundColor}"
                        Stroke="{DynamicResource ThemeDividerColor}"
                        StrokeThickness="1"
                        ZIndex="15">
                    <Grid Padding="10,8"
                          RowDefinitions="Auto,Auto,*,Auto"
                          RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="ForRest Language"
                                       Style="{StaticResource SectionTitleStyle}" />
                                <Label Text="Search supported syntax, helpers, and examples"
                                       Style="{StaticResource PaneMetaStyle}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Entry Grid.Row="1"
                               Text="{Binding LanguageHelpSearchText}"
                               Placeholder="Search ForRest"
                               ClearButtonVisibility="WhileEditing"
                               FontSize="13" />

                        <Grid Grid.Row="2"
                              RowDefinitions="Auto,*"
                              RowSpacing="8">
                            <CollectionView ItemsSource="{Binding LanguageHelpEntries}"
                                            SelectionMode="Single"
                                            SelectionChanged="OnLanguageHelpSelectionChanged"
                                            HeightRequest="192">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource NavigationRowBorderStyle}"
                                                Margin="0">
                                            <VerticalStackLayout Spacing="2">
                                                <Grid ColumnDefinitions="Auto,*"
                                                      ColumnSpacing="8">
                                                    <Label Text="{Binding Category}"
                                                           Style="{StaticResource MonoMetaStyle}"
                                                           VerticalTextAlignment="Start" />
                                                    <VerticalStackLayout Grid.Column="1"
                                                                         Spacing="1">
                                                        <Label Text="{Binding Title}"
                                                               FontFamily="OpenSansSemibold"
                                                               FontSize="12"
                                                               LineBreakMode="TailTruncation" />
                                                        <Label Text="{Binding Summary}"
                                                               Style="{StaticResource PaneMetaStyle}"
                                                               LineBreakMode="TailTruncation"
                                                               MaxLines="2" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <ScrollView Grid.Row="1">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding LanguageHelpEmptyStateText}"
                                           IsVisible="{Binding ShowLanguageHelpEmptyState}"
                                           Style="{StaticResource PaneMetaStyle}" />

                                    <VerticalStackLayout IsVisible="{Binding HasSelectedLanguageHelpEntry}"
                                                         Spacing="8">
                                        <VerticalStackLayout Spacing="1">
                                            <Label Text="{Binding SelectedLanguageHelpTitle}"
                                                   Style="{StaticResource SectionTitleStyle}" />
                                            <Label Text="{Binding SelectedLanguageHelpCategory}"
                                                   Style="{StaticResource MonoMetaStyle}" />
                                        </VerticalStackLayout>

                                        <Label Text="{Binding SelectedLanguageHelpSummary}"
                                               Style="{StaticResource PaneMetaStyle}" />

                                        <Label Text="{Binding SelectedLanguageHelpDocumentation}"
                                               LineBreakMode="WordWrap"
                                               Style="{StaticResource PaneMetaStyle}" />

                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="8">
                                            <Label Text="Example"
                                                   VerticalTextAlignment="Center"
                                                   Style="{StaticResource MonoMetaStyle}" />
                                            <Button Grid.Column="1"
                                                    Text="Copy"
                                                    Style="{StaticResource DenseTabButtonStyle}"
                                                    IsEnabled="{Binding CanCopyLanguageHelpExample}"
                                                    Clicked="OnCopyLanguageHelpExampleClicked"
                                                    SemanticProperties.Description="Copy the selected ForRest example" />
                                        </Grid>

                                        <Border BackgroundColor="{DynamicResource ThemeEditorBackgroundColor}"
                                                Stroke="{DynamicResource ThemeDividerColor}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 8">
                                            <ContentView x:Name="CompactLanguageHelpExampleHost"
                                                         HeightRequest="228" />
                                        </Border>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </ScrollView>
                        </Grid>

                        <Label Grid.Row="3"
                               Text="Reference is limited to syntax the compiler and runtime currently support."
                               Style="{StaticResource MonoMetaStyle}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</ContentView>
