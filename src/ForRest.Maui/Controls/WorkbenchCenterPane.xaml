<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ForRest.Maui.Controls"
             x:Class="ForRest.Maui.Controls.WorkbenchCenterPane">

    <Border Style="{StaticResource PaneBorderStyle}">
        <Grid RowDefinitions="Auto,*,Auto">
            <Grid Padding="14,12,14,8"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="10">
                <Label Text="{Binding SelectedMethod}"
                       VerticalTextAlignment="Start"
                       TextColor="{Binding SelectedMethodColor}"
                       Style="{StaticResource MonoMetaStyle}" />

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2">
                    <Label Text="{Binding RequestName}"
                           Style="{StaticResource PaneTitleStyle}" />
                    <Label Text="{Binding RequestSummary}"
                           Style="{StaticResource PaneMetaStyle}"
                           LineBreakMode="TailTruncation" />
                    <Label Text="{Binding RequestTarget}"
                           Style="{StaticResource MonoMetaStyle}" />
                </VerticalStackLayout>
            </Grid>

            <Grid Grid.Row="1"
                  Padding="8,0,8,8">
                <controls:MonacoEditorSurface Language="forrest"
                                              Text="{Binding RequestEditorText}" />
            </Grid>

            <Grid Grid.Row="2"
                  Padding="12,6"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">
                <Label Text="Variable-aware request drafting surface."
                       Style="{StaticResource PaneMetaStyle}" />
                <Label Grid.Column="1"
                       Text="author"
                       Style="{StaticResource MonoMetaStyle}" />
            </Grid>
        </Grid>
    </Border>
</ContentView>
