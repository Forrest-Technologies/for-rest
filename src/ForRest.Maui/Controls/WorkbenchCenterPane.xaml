<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ForRest.Maui.Controls"
             x:Class="ForRest.Maui.Controls.WorkbenchCenterPane">

    <Border Style="{StaticResource PaneBorderStyle}"
            BackgroundColor="{DynamicResource ThemeEditorBackgroundColor}"
            Stroke="{DynamicResource ThemeDividerColor}">
        <Grid RowDefinitions="Auto,Auto,*">
            <Grid Padding="8,4,8,2"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="6">
                <Label Text="{Binding ActiveDocumentKindLabel}"
                       VerticalTextAlignment="Start"
                       TextColor="{Binding ActiveDocumentKindColor}"
                       Style="{StaticResource MonoMetaStyle}" />

                <Label Grid.Column="1"
                       Text="{Binding ActiveDocumentLabel}"
                       Style="{StaticResource EditorDocumentTitleStyle}" />
            </Grid>

            <Border Grid.Row="1"
                    Margin="8,0,8,6"
                    Padding="8,6"
                    IsVisible="{Binding ShowEditorDebugStrip}"
                    BackgroundColor="{DynamicResource ThemeEditorBackgroundColor}"
                    Stroke="{DynamicResource ThemeDividerColor}"
                    StrokeThickness="1">
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="8"
                      RowSpacing="2">
                    <Label Text="{Binding EditorDebugStateText}"
                           TextColor="{Binding EditorDebugAccentColor}"
                           Style="{StaticResource MonoMetaStyle}" />

                    <Label Grid.Column="1"
                           Text="{Binding EditorDebugSummaryText}"
                           LineBreakMode="TailTruncation"
                           Style="{StaticResource SectionTitleStyle}" />

                    <Label Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Text="{Binding EditorDebugDetailText}"
                           LineBreakMode="TailTruncation"
                           Style="{StaticResource PaneMetaStyle}" />
                </Grid>
            </Border>

            <Grid Grid.Row="2"
                  Padding="0">
                <ContentView x:Name="EditorHost" />

                <Button Text="&#x25B6;"
                        Clicked="OnSendClicked"
                        IsEnabled="{Binding CanSend}"
                        HorizontalOptions="End"
                        VerticalOptions="End"
                        Margin="0,0,18,18"
                        FontSize="18"
                        Padding="0"
                        SemanticProperties.Description="Run script"
                        SemanticProperties.Hint="Runs the current request script"
                        Style="{StaticResource FloatingActionButtonStyle}"
                        ZIndex="10" />
            </Grid>
        </Grid>
    </Border>
</ContentView>
