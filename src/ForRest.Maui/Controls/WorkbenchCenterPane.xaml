<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ForRest.Maui.Controls"
             x:Class="ForRest.Maui.Controls.WorkbenchCenterPane">

    <Border Style="{StaticResource PaneBorderStyle}">
        <Grid RowDefinitions="Auto,*">
            <Grid Padding="10,6,10,4"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="8">
                <Label Text="{Binding SelectedMethod}"
                       VerticalTextAlignment="Start"
                       TextColor="{Binding SelectedMethodColor}"
                       Style="{StaticResource MonoMetaStyle}" />

                <Label Grid.Column="1"
                       Text="{Binding RequestName}"
                       Style="{StaticResource PaneTitleStyle}" />
            </Grid>

            <Grid Grid.Row="1"
                  Padding="0">
                <controls:MonacoEditorSurface Language="forrest"
                                              Text="{Binding RequestEditorText}" />
            </Grid>
        </Grid>
    </Border>
</ContentView>
