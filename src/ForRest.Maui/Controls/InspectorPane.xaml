<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ForRest.Maui.Controls"
             x:Class="ForRest.Maui.Controls.InspectorPane">

    <Border Style="{StaticResource PaneBorderStyle}">
        <Grid RowDefinitions="Auto,Auto,*">
            <Grid Padding="10,8,10,6"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Label Text="Inspect" Style="{StaticResource PaneTitleStyle}" />
                <Button Grid.Column="1"
                        Text="Hide"
                        Style="{StaticResource SubtleToolbarButtonStyle}"
                        Clicked="OnHideClicked" />
            </Grid>

            <ScrollView Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Padding="8,0,8,6"
                                       Spacing="4"
                                       BindableLayout.ItemsSource="{Binding RightPaneTabs}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding Title}"
                                    Style="{StaticResource DenseTabButtonStyle}"
                                    Clicked="OnTabClicked"
                                    CommandParameter="{Binding .}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}" />
                                        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentStrongLight}, Dark={StaticResource AccentStrongDark}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <Grid Grid.Row="2"
                  Padding="10,0,10,10">
                <controls:EditorSurface IsVisible="{Binding IsInspectorResponseVisible}"
                                        Language="json"
                                        IsReadOnly="True"
                                        ShowHeader="False"
                                        ShowFooter="False"
                                        Text="{Binding ResponseBodyText}" />

                <ScrollView IsVisible="{Binding IsInspectorHeadersVisible}">
                    <VerticalStackLayout Padding="2,0,2,0"
                                         Spacing="0">
                        <Grid ColumnDefinitions="130,*"
                              Padding="0,0,0,8">
                            <Label Text="Header"
                                   Style="{StaticResource SectionTitleStyle}" />
                            <Label Grid.Column="1"
                                   Text="Value"
                                   Style="{StaticResource SectionTitleStyle}" />
                        </Grid>

                        <VerticalStackLayout Spacing="0"
                                             BindableLayout.ItemsSource="{Binding ResponseHeaderRows}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource NavigationRowBorderStyle}">
                                        <Grid ColumnDefinitions="130,*">
                                            <Label Text="{Binding Name}"
                                                   Style="{StaticResource MonoTextStyle}" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding Value}"
                                                   LineBreakMode="WordWrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>

                <ScrollView IsVisible="{Binding IsInspectorTraceVisible}">
                    <VerticalStackLayout Spacing="0"
                                         BindableLayout.ItemsSource="{Binding TraceEntries}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource NavigationRowBorderStyle}">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="1">
                                            <Label Text="{Binding Title}"
                                                   TextColor="{Binding AccentColor}"
                                                   Style="{StaticResource SectionTitleStyle}" />
                                            <Label Text="{Binding Detail}"
                                                   Style="{StaticResource PaneMetaStyle}"
                                                   LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1"
                                               Text="{Binding When}"
                                               Style="{StaticResource MonoMetaStyle}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>

                <controls:EditorSurface IsVisible="{Binding IsInspectorRawVisible}"
                                        Language="http"
                                        IsReadOnly="True"
                                        ShowHeader="False"
                                        ShowFooter="False"
                                        Text="{Binding ResponseRawText}" />
            </Grid>
        </Grid>
    </Border>
</ContentView>
