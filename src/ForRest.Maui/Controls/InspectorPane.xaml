<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ForRest.Maui.Controls"
             x:Class="ForRest.Maui.Controls.InspectorPane">

    <Border Style="{StaticResource PaneBorderStyle}">
        <Grid RowDefinitions="Auto,Auto,*">
            <Grid Padding="10,8,10,6"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Label Text="Inspect" Style="{StaticResource PaneTitleStyle}" />
                <Button Grid.Column="1"
                        Text="Hide"
                        Style="{StaticResource SubtleToolbarButtonStyle}"
                        Clicked="OnHideClicked" />
            </Grid>

            <ScrollView Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Padding="8,0,8,6"
                                       Spacing="4"
                                       BindableLayout.ItemsSource="{Binding RightPaneTabs}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding Title}"
                                    Style="{StaticResource DenseTabButtonStyle}"
                                    Clicked="OnTabClicked"
                                    CommandParameter="{Binding .}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSelectionSoftColor}" />
                                        <Setter Property="BorderColor" Value="{DynamicResource ThemeSelectionBorderColor}" />
                                        <Setter Property="TextColor" Value="{DynamicResource ThemeSelectionTextColor}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <Grid Grid.Row="2"
                  Padding="10,0,10,10"
                  RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                      IsVisible="{Binding IsInspectorResponseVisible}"
                      Padding="0,0,0,8">
                    <Label Text="Response body"
                           Style="{StaticResource SectionTitleStyle}" />
                    <Button Grid.Column="1"
                            Text="Copy Body"
                            Style="{StaticResource DenseTabButtonStyle}"
                            Clicked="OnCopyResponseClicked"
                            IsEnabled="{Binding CanCopyResponseBody}" />
                    <Button Grid.Column="2"
                            Text="Copy Raw"
                            Style="{StaticResource DenseTabButtonStyle}"
                            Clicked="OnCopyRawResponseClicked"
                            IsEnabled="{Binding CanCopyRawResponse}" />
                    <Button Grid.Column="3"
                            Text="{Binding ResponsePrettyPrintButtonText}"
                            Style="{StaticResource DenseTabButtonStyle}"
                            Clicked="OnTogglePrettyPrintClicked" />
                </Grid>

                <ContentView x:Name="ResponseBodyViewerHost"
                             Grid.Row="1"
                             IsVisible="{Binding IsInspectorResponseVisible}" />

                <Grid Grid.RowSpan="2"
                      RowDefinitions="Auto,*"
                      IsVisible="{Binding IsInspectorStashVisible}">
                    <Grid ColumnDefinitions="*,Auto,Auto"
                          Padding="0,0,0,8">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Response stash"
                                   Style="{StaticResource SectionTitleStyle}" />
                            <Label Text="Captured script rows realized into a table."
                                   Style="{StaticResource PaneMetaStyle}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Copy Table"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnCopyStashClicked"
                                IsEnabled="{Binding CanCopyStash}" />
                        <Button Grid.Column="2"
                                Text="Export CSV"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnExportStashClicked"
                                IsEnabled="{Binding CanExportStashCsv}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Label Text="{Binding StashEmptyStateText}"
                               Style="{StaticResource PaneMetaStyle}"
                               LineBreakMode="WordWrap"
                               Margin="2,4,2,0"
                               IsVisible="{Binding ShowStashEmptyState}" />

                        <ScrollView IsVisible="{Binding HasStashData}">
                            <ScrollView Orientation="Horizontal"
                                        HorizontalScrollBarVisibility="Always">
                                <VerticalStackLayout Padding="2,0,2,0"
                                                     Spacing="0">
                                    <Border Style="{StaticResource NavigationRowBorderStyle}"
                                            Margin="0,0,0,6">
                                        <HorizontalStackLayout Spacing="0"
                                                               BindableLayout.ItemsSource="{Binding StashColumns}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Label Text="{Binding Title}"
                                                           WidthRequest="176"
                                                           Padding="8,6"
                                                           Style="{StaticResource SectionTitleStyle}"
                                                           LineBreakMode="WordWrap" />
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </HorizontalStackLayout>
                                    </Border>

                                    <VerticalStackLayout Spacing="0"
                                                         BindableLayout.ItemsSource="{Binding StashRows}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource NavigationRowBorderStyle}"
                                                        Margin="0,0,0,6">
                                                    <HorizontalStackLayout Spacing="0"
                                                                           BindableLayout.ItemsSource="{Binding Cells}">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate>
                                                                <controls:CopyableLabel Text="{Binding Value}"
                                                                                        CopyText="{Binding Value}"
                                                                                        CopiedMessage="Copied stash cell."
                                                                                        Copied="OnInlineCopyCompleted"
                                                                                        WidthRequest="176"
                                                                                        Padding="8,6"
                                                                                        Style="{StaticResource MonoTextStyle}"
                                                                                        VerticalTextAlignment="Start"
                                                                                        LineBreakMode="WordWrap" />
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </HorizontalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </ScrollView>
                        </ScrollView>
                    </Grid>
                </Grid>

                <Grid Grid.RowSpan="2"
                      RowDefinitions="Auto,*"
                      IsVisible="{Binding IsInspectorHeadersVisible}">
                    <Grid ColumnDefinitions="*,Auto"
                          Padding="0,0,0,8">
                        <Label Text="Response headers"
                               Style="{StaticResource SectionTitleStyle}" />
                        <Button Grid.Column="1"
                                Text="Copy Headers"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnCopyHeadersClicked"
                                IsEnabled="{Binding CanCopyHeaders}" />
                    </Grid>

                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Padding="2,0,2,0"
                                             Spacing="0">
                            <Grid ColumnDefinitions="130,*"
                                  Padding="0,0,0,8">
                                <Label Text="Header"
                                       Style="{StaticResource SectionTitleStyle}" />
                                <Label Grid.Column="1"
                                       Text="Value"
                                       Style="{StaticResource SectionTitleStyle}" />
                            </Grid>

                            <VerticalStackLayout Spacing="0"
                                                 BindableLayout.ItemsSource="{Binding ResponseHeaderRows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource NavigationRowBorderStyle}">
                                            <Grid ColumnDefinitions="130,*">
                                                <Label Text="{Binding Name}"
                                                       Style="{StaticResource MonoTextStyle}" />
                                                <controls:CopyableLabel Grid.Column="1"
                                                                        Text="{Binding Value}"
                                                                        CopyText="{Binding Value}"
                                                                        CopiedMessage="Copied header value."
                                                                        Copied="OnInlineCopyCompleted"
                                                                        LineBreakMode="WordWrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>

                <Grid Grid.RowSpan="2"
                      RowDefinitions="Auto,*"
                      IsVisible="{Binding IsInspectorTraceVisible}">
                    <Grid ColumnDefinitions="*,Auto"
                          Padding="0,0,0,8">
                        <Label Text="Execution trace"
                               Style="{StaticResource SectionTitleStyle}" />
                        <Button Grid.Column="1"
                                Text="Copy Trace"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnCopyTraceClicked"
                                IsEnabled="{Binding CanCopyTrace}" />
                    </Grid>

                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="0"
                                             BindableLayout.ItemsSource="{Binding TraceEntries}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource NavigationRowBorderStyle}">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="{Binding Title}"
                                                       TextColor="{Binding AccentColor}"
                                                       Style="{StaticResource SectionTitleStyle}" />
                                                <controls:CopyableLabel Text="{Binding Detail}"
                                                                        CopyText="{Binding Detail}"
                                                                        CopiedMessage="Copied trace detail."
                                                                        Copied="OnInlineCopyCompleted"
                                                                        Style="{StaticResource PaneMetaStyle}"
                                                                        LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{Binding When}"
                                                   Style="{StaticResource MonoMetaStyle}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>

                <Grid Grid.RowSpan="2"
                      RowDefinitions="Auto,*"
                      IsVisible="{Binding IsInspectorRawVisible}">
                    <Grid ColumnDefinitions="*,Auto"
                          Padding="0,0,0,8">
                        <Label Text="Raw exchange"
                               Style="{StaticResource SectionTitleStyle}" />
                        <Button Grid.Column="1"
                                Text="Copy Raw"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnCopyRawResponseClicked"
                                IsEnabled="{Binding CanCopyRawResponse}" />
                    </Grid>

                    <controls:EditorSurface Grid.Row="1"
                                            Language="http"
                                            IsReadOnly="True"
                                            ShowHeader="False"
                                            ShowFooter="False"
                                            Text="{Binding ResponseRawText}" />
                </Grid>

                <Grid Grid.RowSpan="2"
                      RowDefinitions="Auto,*"
                      IsVisible="{Binding IsInspectorDebugVisible}">
                    <Grid ColumnDefinitions="*,Auto"
                          Padding="0,0,0,8">
                        <Label Text="Debug output"
                               Style="{StaticResource SectionTitleStyle}" />
                        <Button Grid.Column="1"
                                Text="Copy Debug"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnCopyDebugClicked"
                                IsEnabled="{Binding CanCopyDebugOutput}" />
                    </Grid>

                    <controls:EditorSurface Grid.Row="1"
                                            Language="plaintext"
                                            IsReadOnly="True"
                                            ShowHeader="False"
                                            ShowFooter="False"
                                            Text="{Binding DebugOutputText}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</ContentView>
