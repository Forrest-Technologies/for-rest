<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ForRest.Maui.Controls"
             x:Class="ForRest.Maui.Controls.InspectorPane"
             x:Name="InspectorRoot">

    <Border Style="{StaticResource PaneBorderStyle}">
        <Grid RowDefinitions="Auto,Auto,*">
            <Grid Padding="10,8,10,6"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Label Text="Inspect" Style="{StaticResource PaneTitleStyle}" />
                <Button Grid.Column="1"
                        Text="Hide"
                        Style="{StaticResource SubtleToolbarButtonStyle}"
                        Clicked="OnHideClicked" />
            </Grid>

            <ScrollView Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Padding="8,0,8,6"
                                       Spacing="4"
                                       BindableLayout.ItemsSource="{Binding RightPaneTabs}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding Title}"
                                    FontSize="{Binding BindingContext.ResultPaneTabFontSize, Source={x:Reference InspectorRoot}}"
                                    Style="{StaticResource DenseTabButtonStyle}"
                                    Clicked="OnTabClicked"
                                    CommandParameter="{Binding .}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSelectionSoftColor}" />
                                        <Setter Property="BorderColor" Value="{DynamicResource ThemeSelectionBorderColor}" />
                                        <Setter Property="TextColor" Value="{DynamicResource ThemeSelectionTextColor}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <Grid Grid.Row="2"
                  Padding="10,0,10,10"
                  RowDefinitions="Auto,*">
                <Grid Grid.RowSpan="2"
                      RowDefinitions="Auto,Auto,Auto,*"
                      IsVisible="{Binding IsInspectorResponseVisible}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Response body"
                               LineBreakMode="TailTruncation"
                               MaxLines="1"
                               Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="{Binding SelectedResponseSnapshotSummaryText}"
                               LineBreakMode="WordWrap"
                               MaxLines="2"
                               Style="{StaticResource PaneMetaStyle}" />
                        <Label Text="{Binding SelectedResponseSnapshotTargetText}"
                               LineBreakMode="WordWrap"
                               MaxLines="2"
                               Style="{StaticResource MonoMetaStyle}" />
                        <Label Text="{Binding SelectedResponseSnapshotMetaText}"
                               LineBreakMode="WordWrap"
                               MaxLines="2"
                               Style="{StaticResource PaneMetaStyle}" />
                    </VerticalStackLayout>

                    <FlexLayout Grid.Row="1"
                                Margin="0,8,0,8"
                                Direction="Row"
                                Wrap="Wrap"
                                AlignItems="Center"
                                JustifyContent="Start">
                        <Button Margin="0,0,8,8"
                                Text="Prev"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnPreviousResponseSnapshotClicked"
                                IsVisible="{Binding ShowResponseSnapshotSelector}"
                                IsEnabled="{Binding CanSelectPreviousResponseSnapshot}" />
                        <Button Margin="0,0,8,8"
                                Text="Next"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnNextResponseSnapshotClicked"
                                IsVisible="{Binding ShowResponseSnapshotSelector}"
                                IsEnabled="{Binding CanSelectNextResponseSnapshot}" />
                        <Button Margin="0,0,8,8"
                                Text="Copy Body"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnCopyResponseClicked"
                                IsEnabled="{Binding CanCopyResponseBody}" />
                        <Button Margin="0,0,8,8"
                                Text="Copy Raw"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnCopyRawResponseClicked"
                                IsEnabled="{Binding CanCopyRawResponse}" />
                        <Button Margin="0,0,8,8"
                                Text="{Binding ResponsePrettyPrintButtonText}"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnTogglePrettyPrintClicked" />
                        <Button Margin="0,0,8,8"
                                Text="{Binding HtmlPreviewButtonText}"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnToggleHtmlPreviewClicked"
                                IsVisible="{Binding IsHtmlResponse}" />
                        <Button Margin="0,0,8,8"
                                Text="Save Body"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnSaveResponseBodyClicked"
                                IsEnabled="{Binding CanCopyResponseBody}" />
                        <Button Margin="0,0,8,8"
                                Text="Save Raw"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnSaveRawResponseClicked"
                                IsEnabled="{Binding CanCopyRawResponse}" />
                    </FlexLayout>

                    <ScrollView x:Name="ResponseSnapshotRail"
                                Grid.Row="2"
                                Margin="0,0,0,8"
                                HeightRequest="92"
                                Orientation="Horizontal"
                                IsVisible="{Binding ShowResponseSnapshotSelector}"
                                HorizontalScrollBarVisibility="Always">
                        <HorizontalStackLayout Spacing="8"
                                               BindableLayout.ItemsSource="{Binding ResponseSnapshotEntries}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border WidthRequest="156"
                                            Padding="10,8"
                                            BackgroundColor="{DynamicResource ThemeEditorBackgroundColor}"
                                            Stroke="{DynamicResource ThemeDividerColor}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnResponseSnapshotTapped" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border"
                                                         Binding="{Binding IsSelected}"
                                                         Value="True">
                                                <Setter Property="BackgroundColor"
                                                        Value="{DynamicResource ThemeSelectionSoftColor}" />
                                                <Setter Property="Stroke"
                                                        Value="{DynamicResource ThemeSelectionBorderColor}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding ChipText}"
                                                   Style="{StaticResource MonoMetaStyle}" />
                                            <Label Text="{Binding StatusText}"
                                                   TextColor="{Binding AccentColor}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"
                                                   Style="{StaticResource SectionTitleStyle}" />
                                            <Label Text="{Binding DetailText}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"
                                                   Style="{StaticResource PaneMetaStyle}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <ContentView x:Name="ResponseBodyViewerHost"
                                 Grid.Row="3" />
                </Grid>

                <Grid Grid.RowSpan="2"
                      RowDefinitions="Auto,Auto,Auto,*"
                      IsVisible="{Binding IsInspectorRequestVisible}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Request body"
                               LineBreakMode="TailTruncation"
                               MaxLines="1"
                               Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="{Binding SelectedRequestSnapshotSummaryText}"
                               LineBreakMode="WordWrap"
                               MaxLines="2"
                               Style="{StaticResource PaneMetaStyle}" />
                        <Label Text="{Binding SelectedRequestSnapshotTargetText}"
                               LineBreakMode="WordWrap"
                               MaxLines="2"
                               Style="{StaticResource MonoMetaStyle}" />
                        <Label Text="{Binding SelectedRequestSnapshotMetaText}"
                               LineBreakMode="WordWrap"
                               MaxLines="2"
                               Style="{StaticResource PaneMetaStyle}" />
                    </VerticalStackLayout>

                    <FlexLayout Grid.Row="1"
                                Margin="0,8,0,8"
                                Direction="Row"
                                Wrap="Wrap"
                                AlignItems="Center"
                                JustifyContent="Start">
                        <Button Margin="0,0,8,8"
                                Text="Prev"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnPreviousRequestSnapshotClicked"
                                IsVisible="{Binding ShowRequestSnapshotSelector}"
                                IsEnabled="{Binding CanSelectPreviousRequestSnapshot}" />
                        <Button Margin="0,0,8,8"
                                Text="Next"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnNextRequestSnapshotClicked"
                                IsVisible="{Binding ShowRequestSnapshotSelector}"
                                IsEnabled="{Binding CanSelectNextRequestSnapshot}" />
                        <Button Margin="0,0,8,8"
                                Text="Copy Body"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnCopyRequestClicked"
                                IsEnabled="{Binding CanCopyRequestBody}" />
                        <Button Margin="0,0,8,8"
                                Text="Copy Raw"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnCopyRawRequestClicked"
                                IsEnabled="{Binding CanCopyRawRequest}" />
                        <Button Margin="0,0,8,8"
                                Text="{Binding ResponsePrettyPrintButtonText}"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnTogglePrettyPrintClicked" />
                    </FlexLayout>

                    <ScrollView x:Name="RequestSnapshotRail"
                                Grid.Row="2"
                                Margin="0,0,0,8"
                                HeightRequest="92"
                                Orientation="Horizontal"
                                IsVisible="{Binding ShowRequestSnapshotSelector}"
                                HorizontalScrollBarVisibility="Always">
                        <HorizontalStackLayout Spacing="8"
                                               BindableLayout.ItemsSource="{Binding RequestSnapshotEntries}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border WidthRequest="156"
                                            Padding="10,8"
                                            BackgroundColor="{DynamicResource ThemeEditorBackgroundColor}"
                                            Stroke="{DynamicResource ThemeDividerColor}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnRequestSnapshotTapped" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border"
                                                         Binding="{Binding IsSelected}"
                                                         Value="True">
                                                <Setter Property="BackgroundColor"
                                                        Value="{DynamicResource ThemeSelectionSoftColor}" />
                                                <Setter Property="Stroke"
                                                        Value="{DynamicResource ThemeSelectionBorderColor}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding ChipText}"
                                                   Style="{StaticResource MonoMetaStyle}" />
                                            <Label Text="{Binding MethodText}"
                                                   TextColor="{Binding AccentColor}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"
                                                   Style="{StaticResource SectionTitleStyle}" />
                                            <Label Text="{Binding DetailText}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"
                                                   Style="{StaticResource PaneMetaStyle}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <ContentView x:Name="RequestBodyViewerHost"
                                 Grid.Row="3" />
                </Grid>

                <Grid Grid.RowSpan="2"
                      RowDefinitions="Auto,Auto,Auto,*,Auto"
                      RowSpacing="8"
                      IsVisible="{Binding IsInspectorStashVisible}">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Response stash"
                               Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="{Binding StashSummaryText}"
                               Style="{StaticResource PaneMetaStyle}" />
                        <Label Text="{Binding StashFilterSummaryText}"
                               Style="{StaticResource PaneMetaStyle}" />
                    </VerticalStackLayout>

                    <FlexLayout Grid.Row="1"
                                Direction="Row"
                                Wrap="Wrap"
                                AlignItems="Center"
                                JustifyContent="Start">
                        <Button Margin="0,0,8,8"
                                Text="Copy Table"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnCopyStashClicked"
                                IsEnabled="{Binding CanCopyStash}" />
                        <Button Margin="0,0,8,8"
                                Text="Copy Row"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnCopySelectedStashClicked"
                                IsEnabled="{Binding CanCopySelectedStashRow}" />
                        <Button Margin="0,0,8,8"
                                Text="Export CSV"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnExportStashClicked"
                                IsEnabled="{Binding CanExportStashCsv}" />
                    </FlexLayout>

                    <Border Grid.Row="2"
                            Style="{StaticResource ToolbarFieldBorderStyle}"
                            IsVisible="{Binding HasStashData}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="8">
                                <Label Text="Filter"
                                       VerticalTextAlignment="Center"
                                       Style="{StaticResource SectionTitleStyle}" />
                                <Entry Grid.Column="1"
                                       Text="{Binding StashSearchText}"
                                       Placeholder="Filter stash rows or columns"
                                       ClearButtonVisibility="WhileEditing"
                                       Style="{StaticResource CompactToolbarEntryStyle}" />
                                <Button Grid.Column="2"
                                        Text="Clear"
                                        Style="{StaticResource DenseTabButtonStyle}"
                                        Clicked="OnClearStashFilterClicked"
                                        IsEnabled="{Binding CanClearStashSearch}" />
                            </Grid>
                            <FlexLayout Direction="Row"
                                        Wrap="Wrap"
                                        AlignItems="Center"
                                        JustifyContent="Start">
                                <Button Margin="0,0,8,8"
                                        Text="{Binding StashSortButtonText}"
                                        Style="{StaticResource DenseTabButtonStyle}"
                                        Clicked="OnChangeStashSortClicked" />
                                <Button Margin="0,0,8,8"
                                        Text="{Binding StashSortDirectionButtonText}"
                                        Style="{StaticResource DenseTabButtonStyle}"
                                        Clicked="OnToggleStashSortDirectionClicked" />
                                <Button Margin="0,0,8,8"
                                        Text="{Binding HideEmptyStashColumnsButtonText}"
                                        Style="{StaticResource DenseTabButtonStyle}"
                                        Clicked="OnToggleHideEmptyStashColumnsClicked" />
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Grid Grid.Row="3">
                        <Label Text="{Binding StashEmptyStateText}"
                               Style="{StaticResource PaneMetaStyle}"
                               LineBreakMode="WordWrap"
                               Margin="2,4,2,0"
                               IsVisible="{Binding ShowStashEmptyState}" />

                        <Label Text="{Binding StashFilterEmptyStateText}"
                               Style="{StaticResource PaneMetaStyle}"
                               LineBreakMode="WordWrap"
                               Margin="2,4,2,0"
                               IsVisible="{Binding ShowStashFilterEmptyState}" />

                        <ScrollView IsVisible="{Binding ShowDesktopStashTable}">
                            <ScrollView Orientation="Horizontal"
                                        HorizontalScrollBarVisibility="Always">
                                <VerticalStackLayout Padding="2,0,2,0"
                                                     Spacing="0">
                                    <Border Style="{StaticResource NavigationRowBorderStyle}"
                                            Margin="0,0,0,6"
                                            BackgroundColor="{DynamicResource ThemeSurfaceRaisedColor}"
                                            Stroke="{DynamicResource ThemeDividerColor}"
                                            StrokeThickness="1">
                                        <HorizontalStackLayout Spacing="0">
                                            <VerticalStackLayout WidthRequest="96"
                                                                 Padding="8,6"
                                                                 Spacing="1">
                                                <Label Text="Row"
                                                       Style="{StaticResource SectionTitleStyle}" />
                                                <Label Text="Selection"
                                                       Style="{StaticResource MonoMetaStyle}" />
                                            </VerticalStackLayout>
                                            <HorizontalStackLayout Spacing="0"
                                                                   BindableLayout.ItemsSource="{Binding StashColumns}">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                            <VerticalStackLayout WidthRequest="176"
                                                                                 Padding="8,6"
                                                                                 Spacing="1">
                                                                <Label Text="{Binding Title}"
                                                                       Style="{StaticResource SectionTitleStyle}"
                                                                       LineBreakMode="WordWrap" />
                                                                <Label Text="{Binding SummaryText}"
                                                                       Style="{StaticResource MonoMetaStyle}" />
                                                            </VerticalStackLayout>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </HorizontalStackLayout>
                                        </HorizontalStackLayout>
                                    </Border>

                                    <VerticalStackLayout Spacing="0"
                                                         BindableLayout.ItemsSource="{Binding StashRows}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource NavigationRowBorderStyle}"
                                                        Margin="0,0,0,6"
                                                        BackgroundColor="{DynamicResource ThemeEditorBackgroundColor}"
                                                        Stroke="{DynamicResource ThemeDividerColor}"
                                                        StrokeThickness="1">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnStashRowTapped" />
                                                    </Border.GestureRecognizers>
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border"
                                                                     Binding="{Binding IsAlternate}"
                                                                     Value="True">
                                                            <Setter Property="BackgroundColor"
                                                                    Value="{DynamicResource ThemeSurfaceRaisedColor}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Border"
                                                                     Binding="{Binding IsSelected}"
                                                                     Value="True">
                                                            <Setter Property="BackgroundColor"
                                                                    Value="{DynamicResource ThemeSelectionSoftColor}" />
                                                            <Setter Property="Stroke"
                                                                    Value="{DynamicResource ThemeSelectionBorderColor}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <HorizontalStackLayout Spacing="0">
                                                        <VerticalStackLayout WidthRequest="96"
                                                                             Padding="8,6"
                                                                             Spacing="1">
                                                            <Label Text="{Binding RowLabel}"
                                                                   Style="{StaticResource SectionTitleStyle}"
                                                                   VerticalTextAlignment="Start" />
                                                            <Label Text="{Binding DetailSummaryText}"
                                                                   Style="{StaticResource MonoMetaStyle}"
                                                                   LineBreakMode="WordWrap"
                                                                   MaxLines="2" />
                                                        </VerticalStackLayout>
                                                        <HorizontalStackLayout Spacing="0"
                                                                               BindableLayout.ItemsSource="{Binding Cells}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate>
                                                                    <controls:CopyableLabel Text="{Binding DisplayValue}"
                                                                                            CopyText="{Binding Value}"
                                                                                            CopiedMessage="Copied stash cell."
                                                                                            Copied="OnInlineCopyCompleted"
                                                                                            WidthRequest="176"
                                                                                            Padding="8,6"
                                                                                            Style="{StaticResource MonoTextStyle}"
                                                                                            VerticalTextAlignment="Start"
                                                                                            LineBreakMode="WordWrap">
                                                                        <controls:CopyableLabel.Triggers>
                                                                            <DataTrigger TargetType="controls:CopyableLabel"
                                                                                         Binding="{Binding IsEmpty}"
                                                                                         Value="True">
                                                                                <Setter Property="TextColor"
                                                                                        Value="{DynamicResource ThemeTextMutedColor}" />
                                                                            </DataTrigger>
                                                                        </controls:CopyableLabel.Triggers>
                                                                    </controls:CopyableLabel>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </HorizontalStackLayout>
                                                    </HorizontalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </ScrollView>
                        </ScrollView>

                        <ScrollView IsVisible="{Binding ShowCompactStashCards}">
                            <VerticalStackLayout Padding="2,0,2,0"
                                                 Spacing="8"
                                                 BindableLayout.ItemsSource="{Binding StashRows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SectionBorderStyle}"
                                                Padding="10,8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnStashRowTapped" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border"
                                                             Binding="{Binding IsSelected}"
                                                             Value="True">
                                                    <Setter Property="BackgroundColor"
                                                            Value="{DynamicResource ThemeSelectionSoftColor}" />
                                                    <Setter Property="Stroke"
                                                            Value="{DynamicResource ThemeSelectionBorderColor}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <VerticalStackLayout Spacing="8">
                                                <Grid ColumnDefinitions="Auto,*"
                                                      ColumnSpacing="10">
                                                    <Label Text="{Binding RowHeadingText}"
                                                           Style="{StaticResource SectionTitleStyle}" />
                                                    <Label Grid.Column="1"
                                                           Text="{Binding DetailSummaryText}"
                                                           Style="{StaticResource MonoMetaStyle}"
                                                           HorizontalTextAlignment="End" />
                                                </Grid>
                                                <Label Text="{Binding PreviewText}"
                                                       Style="{StaticResource PaneMetaStyle}"
                                                       LineBreakMode="WordWrap"
                                                       MaxLines="3" />
                                                <VerticalStackLayout Spacing="0"
                                                                     BindableLayout.ItemsSource="{Binding Details}">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource NavigationRowBorderStyle}"
                                                                    Margin="0,0,0,6">
                                                                <Grid ColumnDefinitions="120,*"
                                                                      ColumnSpacing="10">
                                                                    <Label Text="{Binding Name}"
                                                                           Style="{StaticResource MonoMetaStyle}" />
                                                                    <controls:CopyableLabel Grid.Column="1"
                                                                                            Text="{Binding Value}"
                                                                                            CopyText="{Binding Value}"
                                                                                            CopiedMessage="Copied stash detail."
                                                                                            Copied="OnInlineCopyCompleted"
                                                                                            Style="{StaticResource MonoTextStyle}"
                                                                                            LineBreakMode="WordWrap" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Grid>

                    <Border Grid.Row="4"
                            Style="{StaticResource SectionBorderStyle}"
                            Padding="10,8"
                            IsVisible="{Binding ShowDesktopSelectedStashPanel}">
                        <Grid RowDefinitions="Auto,*"
                              RowSpacing="8">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="Selected stash row"
                                           Style="{StaticResource MonoMetaStyle}" />
                                    <Label Text="{Binding SelectedStashRowTitleText}"
                                           Style="{StaticResource SectionTitleStyle}" />
                                    <Label Text="{Binding SelectedStashRowSummaryText}"
                                           Style="{StaticResource PaneMetaStyle}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="Copy Row"
                                        Style="{StaticResource DenseTabButtonStyle}"
                                        Clicked="OnCopySelectedStashClicked"
                                        IsEnabled="{Binding CanCopySelectedStashRow}" />
                            </Grid>

                            <ScrollView Grid.Row="1"
                                         HeightRequest="168">
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="The selected row has no populated fields."
                                           Style="{StaticResource PaneMetaStyle}"
                                           LineBreakMode="WordWrap"
                                           Margin="0,0,0,8"
                                           IsVisible="{Binding ShowSelectedStashDetailsEmptyState}" />
                                    <VerticalStackLayout Spacing="0"
                                                         BindableLayout.ItemsSource="{Binding SelectedStashDetails}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource NavigationRowBorderStyle}"
                                                        Margin="0">
                                                    <Grid ColumnDefinitions="130,*"
                                                          ColumnSpacing="10">
                                                        <Label Text="{Binding Name}"
                                                               Style="{StaticResource MonoMetaStyle}" />
                                                        <controls:CopyableLabel Grid.Column="1"
                                                                                Text="{Binding Value}"
                                                                                CopyText="{Binding Value}"
                                                                                CopiedMessage="Copied stash detail."
                                                                                Copied="OnInlineCopyCompleted"
                                                                                Style="{StaticResource MonoTextStyle}"
                                                                                LineBreakMode="WordWrap" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </ScrollView>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.RowSpan="2"
                      RowDefinitions="Auto,*"
                      IsVisible="{Binding IsInspectorHeadersVisible}">
                    <Grid ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="8"
                          Padding="0,0,0,8">
                        <Label Text="Response headers"
                               Style="{StaticResource SectionTitleStyle}" />
                        <Button Grid.Column="1"
                                Text="Copy Headers"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnCopyHeadersClicked"
                                IsEnabled="{Binding CanCopyHeaders}" />
                        <Button Grid.Column="2"
                                Text="Save Headers"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnSaveHeadersClicked"
                                IsEnabled="{Binding CanCopyHeaders}" />
                    </Grid>

                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Padding="2,0,2,0"
                                             Spacing="0">
                            <Grid ColumnDefinitions="130,*"
                                  Padding="0,0,0,8">
                                <Label Text="Header"
                                       Style="{StaticResource SectionTitleStyle}" />
                                <Label Grid.Column="1"
                                       Text="Value"
                                       Style="{StaticResource SectionTitleStyle}" />
                            </Grid>

                            <VerticalStackLayout Spacing="0"
                                                 BindableLayout.ItemsSource="{Binding ResponseHeaderRows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource NavigationRowBorderStyle}">
                                            <Grid ColumnDefinitions="130,*">
                                                <Label Text="{Binding Name}"
                                                       Style="{StaticResource MonoTextStyle}" />
                                                <controls:CopyableLabel Grid.Column="1"
                                                                        Text="{Binding Value}"
                                                                        CopyText="{Binding Value}"
                                                                        CopiedMessage="Copied header value."
                                                                        Copied="OnInlineCopyCompleted"
                                                                        LineBreakMode="WordWrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>

                <Grid Grid.RowSpan="2"
                      RowDefinitions="Auto,*"
                      IsVisible="{Binding IsInspectorTraceVisible}">
                    <Grid ColumnDefinitions="*,Auto"
                          Padding="0,0,0,8">
                        <Label Text="Execution trace"
                               Style="{StaticResource SectionTitleStyle}" />
                        <Button Grid.Column="1"
                                Text="Copy Trace"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnCopyTraceClicked"
                                IsEnabled="{Binding CanCopyTrace}" />
                    </Grid>

                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="0"
                                             BindableLayout.ItemsSource="{Binding TraceEntries}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource NavigationRowBorderStyle}">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="{Binding Title}"
                                                       TextColor="{Binding AccentColor}"
                                                       Style="{StaticResource SectionTitleStyle}" />
                                                <controls:CopyableLabel Text="{Binding Detail}"
                                                                        CopyText="{Binding Detail}"
                                                                        CopiedMessage="Copied trace detail."
                                                                        Copied="OnInlineCopyCompleted"
                                                                        Style="{StaticResource PaneMetaStyle}"
                                                                        LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{Binding When}"
                                                   Style="{StaticResource MonoMetaStyle}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>

                <Grid Grid.RowSpan="2"
                      RowDefinitions="Auto,*"
                      IsVisible="{Binding IsInspectorRawVisible}">
                    <Grid ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="8"
                          Padding="0,0,0,8">
                        <Label Text="Raw exchange"
                               Style="{StaticResource SectionTitleStyle}" />
                        <Button Grid.Column="1"
                                Text="Copy Raw"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnCopyRawResponseClicked"
                                IsEnabled="{Binding CanCopyRawResponse}" />
                        <Button Grid.Column="2"
                                Text="Save Raw"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnSaveRawResponseClicked"
                                IsEnabled="{Binding CanCopyRawResponse}" />
                    </Grid>

                    <controls:EditorSurface Grid.Row="1"
                                            Language="http"
                                            IsReadOnly="True"
                                            ShowHeader="False"
                                            ShowFooter="False"
                                            Text="{Binding ResponseRawText}" />
                </Grid>

                <Grid Grid.RowSpan="2"
                      RowDefinitions="Auto,*"
                      IsVisible="{Binding IsInspectorDebugVisible}">
                    <Grid ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="6"
                          Padding="0,0,0,8">
                        <Label Text="Debug output"
                               Style="{StaticResource SectionTitleStyle}" />
                        <Button Grid.Column="1"
                                Text="Copy Summary"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnCopyDebugSummaryClicked"
                                IsEnabled="{Binding CanCopyDebugSummary}" />
                        <Button Grid.Column="2"
                                Text="Copy Debug"
                                Style="{StaticResource DenseTabButtonStyle}"
                                Clicked="OnCopyDebugClicked"
                                IsEnabled="{Binding CanCopyDebugOutput}" />
                    </Grid>

                    <controls:EditorSurface Grid.Row="1"
                                            Language="plaintext"
                                            IsReadOnly="True"
                                            ShowHeader="False"
                                            ShowFooter="False"
                                            Text="{Binding DebugOutputText}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</ContentView>
