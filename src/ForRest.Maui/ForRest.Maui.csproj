<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<DefaultTargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</DefaultTargetFrameworks>
		<WindowsOnlyTargetFrameworks>net10.0-windows10.0.19041.0</WindowsOnlyTargetFrameworks>
		<ForRestWindowsRuntimeIdentifiers>win-x64;win-arm64</ForRestWindowsRuntimeIdentifiers>
		<TargetFrameworks Condition="'$(TargetFrameworks)' == '' and '$(ForRestWindowsOnly)' == 'true'">$(WindowsOnlyTargetFrameworks)</TargetFrameworks>
		<TargetFrameworks Condition="'$(TargetFrameworks)' == '' and '$(ForRestWindowsOnly)' != 'true'">$(DefaultTargetFrameworks)</TargetFrameworks>
		<RuntimeIdentifiers Condition="'$(ForRestWindowsOnly)' == 'true' and '$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' == ''">$(ForRestWindowsRuntimeIdentifiers)</RuntimeIdentifiers>
		<OutputType>Exe</OutputType>
		<RootNamespace>ForRest.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<ApplicationTitle>For-Rest</ApplicationTitle>
		<ApplicationId>com.forrest.maui</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<WindowsPackageType>None</WindowsPackageType>
		<ForRestAndroidRuntimeIdentifiers>android-arm64;android-x64</ForRestAndroidRuntimeIdentifiers>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' == ''">$(ForRestAndroidRuntimeIdentifiers)</RuntimeIdentifiers>
		<AndroidPackageFormats Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(AndroidPackageFormats)' == ''">apk;aab</AndroidPackageFormats>
		<PublishTrimmed Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</PublishTrimmed>
		<RunAOTCompilation Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</RunAOTCompilation>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<ForRestBuildDateUtc Condition="'$(ForRestBuildDateUtc)' == ''">$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</ForRestBuildDateUtc>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>ForRestBuildDateUtc</_Parameter1>
			<_Parameter2>$(ForRestBuildDateUtc)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ForRest.Models\ForRest.Models.csproj" />
		<ProjectReference Include="..\ForRest.Repositories\ForRest.Repositories.csproj" />
		<ProjectReference Include="..\ForRest.Scripting\ForRest.Scripting.csproj" />
		<ProjectReference Include="..\ForRest.Services\ForRest.Services.csproj" />
	</ItemGroup>

	<Target Name="ValidateMonacoAssets" BeforeTargets="PrepareForBuild">
		<Error Condition="!Exists('$(MSBuildProjectDirectory)\Resources\Raw\monaco\vs\loader.js')"
		       Text="Packaged Monaco assets are missing from Resources\Raw\monaco. Run scripts\Update-Monaco.ps1 to restore the local editor bundle." />
	</Target>

</Project>
