<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<DefaultTargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</DefaultTargetFrameworks>
		<WindowsOnlyTargetFrameworks>net10.0-windows10.0.19041.0</WindowsOnlyTargetFrameworks>
		<MacCatalystOnlyTargetFrameworks>net10.0-maccatalyst</MacCatalystOnlyTargetFrameworks>
		<ForRestWindowsRuntimeIdentifiers>win-x64;win-arm64</ForRestWindowsRuntimeIdentifiers>
		<ForRestMacCatalystRuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</ForRestMacCatalystRuntimeIdentifiers>
		<TargetFrameworks Condition="'$(TargetFrameworks)' == '' and '$(ForRestWindowsOnly)' == 'true'">$(WindowsOnlyTargetFrameworks)</TargetFrameworks>
		<TargetFrameworks Condition="'$(TargetFrameworks)' == '' and '$(ForRestMacOnly)' == 'true'">$(MacCatalystOnlyTargetFrameworks)</TargetFrameworks>
		<!-- A macOS host cannot build either default head: the Windows head needs the WinUI XAML
		     compiler (a Windows-only executable) and the Android head needs a separately installed
		     Android SDK. Default a plain `dotnet build` there to the Mac Catalyst head, matching the
		     macOS CI job. Override with -p:TargetFrameworks=net10.0-android to build the Android head
		     from a Mac that does have the Android SDK. -->
		<ForRestMacHostDefault Condition="'$(TargetFrameworks)' == '' and '$(ForRestWindowsOnly)' != 'true' and '$(ForRestMacOnly)' != 'true' and $([MSBuild]::IsOSPlatform('OSX'))">true</ForRestMacHostDefault>
		<TargetFrameworks Condition="'$(TargetFrameworks)' == '' and '$(ForRestMacHostDefault)' == 'true'">$(MacCatalystOnlyTargetFrameworks)</TargetFrameworks>
		<TargetFrameworks Condition="'$(TargetFrameworks)' == '' and '$(ForRestWindowsOnly)' != 'true' and '$(ForRestMacOnly)' != 'true'">$(DefaultTargetFrameworks)</TargetFrameworks>
		<RuntimeIdentifiers Condition="'$(ForRestWindowsOnly)' == 'true' and '$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' == ''">$(ForRestWindowsRuntimeIdentifiers)</RuntimeIdentifiers>
		<RuntimeIdentifiers Condition="'$(ForRestMacOnly)' == 'true' and '$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' == ''">$(ForRestMacCatalystRuntimeIdentifiers)</RuntimeIdentifiers>
		<!-- A plain local `dotnet build` wants one runnable .app, not a universal binary. Building
		     both arches also emits per-arch bundles that carry no app icon — the asset catalog is
		     only applied when the slices are merged — so the obvious-looking
		     bin/<cfg>/net10.0-maccatalyst/<rid>/For-Rest.app launches without a logo. Building the
		     host arch alone produces a single, correctly iconed bundle in half the time. Release
		     and CI still pass -p:ForRestMacOnly=true above for the universal build. -->
		<RuntimeIdentifier Condition="'$(ForRestMacHostDefault)' == 'true' and '$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' == '' and $(NETCoreSdkPortableRuntimeIdentifier.EndsWith('arm64'))">maccatalyst-arm64</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(ForRestMacHostDefault)' == 'true' and '$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' == ''">maccatalyst-x64</RuntimeIdentifier>
		<OutputType>Exe</OutputType>
		<RootNamespace>ForRest.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<ApplicationTitle>For-Rest</ApplicationTitle>
		<ApplicationId>com.forrest.maui</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<WindowsPackageType>None</WindowsPackageType>
		<ForRestAndroidRuntimeIdentifiers>android-arm64;android-x64</ForRestAndroidRuntimeIdentifiers>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' == ''">$(ForRestAndroidRuntimeIdentifiers)</RuntimeIdentifiers>
		<AndroidPackageFormats Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(AndroidPackageFormats)' == ''">apk</AndroidPackageFormats>
		<PublishTrimmed Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Debug' and '$(PublishTrimmed)' == ''">false</PublishTrimmed>
		<PublishTrimmed Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Release' and '$(PublishTrimmed)' == ''">true</PublishTrimmed>
		<AndroidLinkMode Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Debug' and '$(AndroidLinkMode)' == ''">None</AndroidLinkMode>
		<AndroidLinkMode Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Release' and '$(AndroidLinkMode)' == ''">SdkOnly</AndroidLinkMode>
		<TrimMode Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Release' and '$(TrimMode)' == ''">partial</TrimMode>
		<RunAOTCompilation Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</RunAOTCompilation>
		<ForRestAndroidDevKeystorePath Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(ForRestAndroidDevKeystorePath)' == ''">$(MSBuildProjectDirectory)\..\..\build\android\for-rest-dev.keystore</ForRestAndroidDevKeystorePath>
		<ForRestAndroidSigningKeyAlias Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(ForRestAndroidSigningKeyAlias)' == ''">for-rest-dev</ForRestAndroidSigningKeyAlias>
		<ForRestAndroidSigningKeyPass Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(ForRestAndroidSigningKeyPass)' == ''">for-rest-dev</ForRestAndroidSigningKeyPass>
		<ForRestAndroidSigningStorePass Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(ForRestAndroidSigningStorePass)' == ''">for-rest-dev</ForRestAndroidSigningStorePass>
		<AndroidKeyStore Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(AndroidKeyStore)' == '' and Exists('$(ForRestAndroidDevKeystorePath)')">true</AndroidKeyStore>
		<AndroidSigningKeyStore Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(AndroidSigningKeyStore)' == '' and Exists('$(ForRestAndroidDevKeystorePath)')">$(ForRestAndroidDevKeystorePath)</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(AndroidSigningKeyAlias)' == '' and Exists('$(ForRestAndroidDevKeystorePath)')">$(ForRestAndroidSigningKeyAlias)</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(AndroidSigningKeyPass)' == '' and Exists('$(ForRestAndroidDevKeystorePath)')">$(ForRestAndroidSigningKeyPass)</AndroidSigningKeyPass>
		<AndroidSigningStorePass Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(AndroidSigningStorePass)' == '' and Exists('$(ForRestAndroidDevKeystorePath)')">$(ForRestAndroidSigningStorePass)</AndroidSigningStorePass>
		<EmbedAssembliesIntoApk Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(EmbedAssembliesIntoApk)' == ''">true</EmbedAssembliesIntoApk>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<ForRestBuildDateUtc Condition="'$(ForRestBuildDateUtc)' == ''">$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</ForRestBuildDateUtc>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>ForRestBuildDateUtc</_Parameter1>
			<_Parameter2>$(ForRestBuildDateUtc)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- Prevent Android from compressing Monaco editor assets inside the APK.
		     The WebView loads these via file:///android_asset/ and cannot decompress
		     them on the fly — compressed .js/.css/.json files arrive as garbled bytes
		     and Monaco silently fails to initialise (blank white editor). -->
		<AndroidNoCompress Include=".js" />
		<AndroidNoCompress Include=".css" />
		<AndroidNoCompress Include=".json" />
	</ItemGroup>

	<!-- Android is the only head that stages Roslyn reference assemblies as packaged assets;
	     RoslynRuntimeDirectoryBootstrapper unpacks them under #if ANDROID and every other head
	     resolves references from its own app directory. Packaging them elsewhere is dead weight,
	     and the Apple SDK fails the build outright because $(IntermediateOutputPath) does not hold
	     the app assembly at bundle-resource validation time. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<!-- Package generic runtime dependencies from the checked-in cache, but never package app assemblies from snapshots. -->
		<MauiAsset Include="roslyn-runtime\*.dll" Exclude="roslyn-runtime\ForRest.*.dll" LogicalName="roslyn-runtime/%(Filename)%(Extension)" />
		<MauiAsset Include="..\ForRest.Domain\bin\$(Configuration)\net10.0\ForRest.Domain.dll" LogicalName="roslyn-runtime/ForRest.Domain.dll" />
		<MauiAsset Include="..\ForRest.Models\bin\$(Configuration)\net10.0\ForRest.Models.dll" LogicalName="roslyn-runtime/ForRest.Models.dll" />
		<MauiAsset Include="..\ForRest.Plugins.Abstractions\bin\$(Configuration)\net10.0\ForRest.Plugins.Abstractions.dll" LogicalName="roslyn-runtime/ForRest.Plugins.Abstractions.dll" />
		<MauiAsset Include="..\ForRest.Repositories\bin\$(Configuration)\net10.0\ForRest.Repositories.dll" LogicalName="roslyn-runtime/ForRest.Repositories.dll" />
		<MauiAsset Include="..\ForRest.Scripting\bin\$(Configuration)\net10.0\ForRest.Scripting.dll" LogicalName="roslyn-runtime/ForRest.Scripting.dll" />
		<MauiAsset Include="..\ForRest.Services\bin\$(Configuration)\net10.0\ForRest.Services.dll" LogicalName="roslyn-runtime/ForRest.Services.dll" />
		<MauiAsset Include="..\ForRest.Shared\bin\$(Configuration)\net10.0\ForRest.Shared.dll" LogicalName="roslyn-runtime/ForRest.Shared.dll" />
		<MauiAsset Include="$(IntermediateOutputPath)ForRest.Maui.dll" LogicalName="roslyn-runtime/ForRest.Maui.dll" />
	</ItemGroup>

	<!-- Unsigned macOS build: users can run via right-click Open or Security & Privacy settings.
	     Pass -p:ForRestMacUnsigned=true to produce an unsigned .app bundle for testing. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' and '$(ForRestMacUnsigned)' == 'true'">
		<UseInterpreter>true</UseInterpreter>
		<EnableCodeSigning>false</EnableCodeSigning>
		<UseHardenedRuntime>false</UseHardenedRuntime>
	</PropertyGroup>

	<!-- Signed macOS build (default): hardened runtime + entitlements for JIT and sandbox. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' and '$(ForRestMacUnsigned)' != 'true'">
		<UseInterpreter>true</UseInterpreter>
		<UseHardenedRuntime>true</UseHardenedRuntime>
		<CodesignEntitlements>Platforms\MacCatalyst\Entitlements.plist</CodesignEntitlements>
	</PropertyGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<!-- Keep the runtime scripting stack intact while still allowing Android Release to trim the rest of the app. -->
		<TrimmerRootAssembly Include="ForRest.Models" RootMode="All" />
		<TrimmerRootAssembly Include="ForRest.Scripting" RootMode="All" />
		<TrimmerRootAssembly Include="Microsoft.CSharp" RootMode="All" />
		<TrimmerRootAssembly Include="Microsoft.CodeAnalysis" RootMode="All" />
		<TrimmerRootAssembly Include="Microsoft.CodeAnalysis.CSharp" RootMode="All" />
		<TrimmerRootAssembly Include="Microsoft.CodeAnalysis.CSharp.Scripting" RootMode="All" />
		<TrimmerRootAssembly Include="Microsoft.CodeAnalysis.Scripting" RootMode="All" />
		<TrimmerRootAssembly Include="System.Collections.Immutable" RootMode="All" />
		<TrimmerRootAssembly Include="System.Linq" RootMode="All" />
		<TrimmerRootAssembly Include="System.Linq.Expressions" RootMode="All" />
		<TrimmerRootAssembly Include="System.Memory" RootMode="All" />
		<TrimmerRootAssembly Include="System.Private.Uri" RootMode="All" />
		<TrimmerRootAssembly Include="System.Reflection.Emit" RootMode="All" />
		<TrimmerRootAssembly Include="System.Reflection.Emit.ILGeneration" RootMode="All" />
		<TrimmerRootAssembly Include="System.Reflection.Emit.Lightweight" RootMode="All" />
		<TrimmerRootAssembly Include="System.Reflection.Metadata" RootMode="All" />
		<TrimmerRootAssembly Include="System.Runtime.Loader" RootMode="All" />
		<TrimmerRootAssembly Include="System.Security.Cryptography" RootMode="All" />
		<TrimmerRootAssembly Include="System.Security.Cryptography.Algorithms" RootMode="All" />
		<TrimmerRootAssembly Include="System.Security.Cryptography.Primitives" RootMode="All" />
		<TrimmerRootAssembly Include="System.Text.Json" RootMode="All" />
		<TrimmerRootAssembly Include="System.Text.RegularExpressions" RootMode="All" />
		<LinkDescription Include="Linker\ForRest.Android.Scripting.linker.xml" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<!-- Native Sora code editor (Android only). Bound automatically from Maven Central; the
	     language-textmate module pulls the tm4e grammar/theme stack used by SoraEditorSurface.
	     Transitive artifacts are resolved by the Android Maven binding; pin here if CI reports an
	     unresolved dependency. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<!-- ForRestSoraEditor.java is the bound facade over the native Sora editor. It lives under
		     Platforms/Android, which MAUI's default-item globbing excludes (it only re-adds .cs/.xaml
		     per platform), so it must be registered explicitly. Bind="true" generates the C# wrapper
		     consumed by SoraCodeEditorViewHandler. -->
		<AndroidJavaSource Include="Platforms\Android\Editor\ForRestSoraEditor.java" Bind="true" />

		<!-- Sora editor + TextMate engine are consumed through the ForRestSoraEditor.java facade
		     (AndroidJavaSource), not bound directly: the auto-generated C# binding for these large
		     Kotlin libraries does not compile. Bind="false" includes them as runtime Java libraries
		     (and on the facade's javac classpath) without generating C# bindings. -->
		<AndroidMavenLibrary Include="io.github.Rosemoe.sora-editor:editor" Version="0.23.4" Bind="false" />
		<AndroidMavenLibrary Include="io.github.Rosemoe.sora-editor:language-textmate" Version="0.23.4" Bind="false" />

		<!-- Transitive Java runtime dependencies of the TextMate stack that the .NET MAUI Android
		     runtime does not already ship. Included as plain Java libraries (no C# binding needed),
		     so the tm4e grammar/theme parser can resolve them at runtime. Gson is intentionally NOT
		     listed here: MAUI already ships it as GoogleGson.aar, so adding it again duplicates
		     com.google.gson.* and breaks D8 dexing. -->
		<AndroidMavenLibrary Include="org.jruby.jcodings:jcodings" Version="1.0.58" Bind="false" />
		<AndroidMavenLibrary Include="org.jruby.joni:joni" Version="2.2.1" Bind="false" />
		<AndroidMavenLibrary Include="org.snakeyaml:snakeyaml-engine" Version="2.7" Bind="false" />

		<!-- Already provided at runtime by the MAUI Android runtime (AndroidX + Kotlin stdlib +
		     GoogleGson), plus a compile-time-only annotations jar. Ignored for Java dependency
		     verification to avoid pulling conflicting copies alongside MAUI's own train. The full
		     group:artifact:version coordinate is required in Include. -->
		<AndroidIgnoredJavaDependency Include="com.google.code.gson:gson:2.10.1" />
		<AndroidIgnoredJavaDependency Include="androidx.annotation:annotation:1.7.1" />
		<AndroidIgnoredJavaDependency Include="androidx.collection:collection:1.4.0" />
		<AndroidIgnoredJavaDependency Include="org.jetbrains.kotlin:kotlin-stdlib:1.9.22" />
		<AndroidIgnoredJavaDependency Include="org.eclipse.jdt:org.eclipse.jdt.annotation:2.2.800" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ForRest.Models\ForRest.Models.csproj" />
		<ProjectReference Include="..\ForRest.Repositories\ForRest.Repositories.csproj" />
		<ProjectReference Include="..\ForRest.Scripting\ForRest.Scripting.csproj" />
		<ProjectReference Include="..\ForRest.Services\ForRest.Services.csproj" />
	</ItemGroup>

	<!-- MCP server is desktop-only: Windows and Mac Catalyst. Android excluded
	     because the HTTP listener + long-lived background host don't play well
	     with the mobile lifecycle and the user explicitly scoped MCP to desktop. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<ProjectReference Include="..\ForRest.Mcp\ForRest.Mcp.csproj" />
	</ItemGroup>

	<Target Name="ValidateMonacoAssets" BeforeTargets="PrepareForBuild">
		<Error Condition="!Exists('$(MSBuildProjectDirectory)\Resources\Raw\monaco\vs\loader.js')" Text="Packaged Monaco assets are missing from Resources\Raw\monaco. Run scripts\Update-Monaco.ps1 to restore the local editor bundle." />
	</Target>

	<Target Name="ValidateRoslynRuntimeSnapshots" BeforeTargets="PrepareForBuild">
		<ItemGroup>
			<StaleRoslynRuntimeAssemblies Include="$(MSBuildProjectDirectory)\roslyn-runtime\ForRest.*.dll" />
		</ItemGroup>
		<Error Condition="'@(StaleRoslynRuntimeAssemblies)' != ''" Text="Checked-in roslyn-runtime\\ForRest.*.dll snapshots are not allowed. Package current project outputs instead so Android cannot regress to stale app assemblies." />
	</Target>

	<Target Name="ValidateAndroidScriptingBuildSettings" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<Error Condition="'$(PublishAot)' == 'true' or '$(_AndroidRuntime)' == 'NativeAOT'" Text="ForRest uses Roslyn runtime scripting on Android. PublishAot/NativeAOT builds are not supported because runtime script compilation and execution require a JIT/interpreter-capable runtime." />
		<Error Condition="'$(PublishTrimmed)' == 'true' and ('$(AndroidLinkMode)' == 'Full' or '$(TrimMode)' == 'full')" Text="ForRest Android scripting builds only support SdkOnly/partial trimming. Full trimming can strip APIs that runtime scripts need even when the app itself does not reference them directly." />
		<Error Condition="'$(EmbedAssembliesIntoApk)' != 'true'" Text="ForRest Android builds with runtime scripting must embed managed assemblies into the package so device deploys and Roslyn metadata staging both work reliably." />
	</Target>

</Project>
