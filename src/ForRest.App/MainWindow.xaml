<Window x:Class="ForRest.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    Title="For-Rest">
    <Grid x:Name="RootLayout" Background="{ThemeResource ShellBackgroundBrush}" Loaded="OnLoaded" SizeChanged="OnRootLayoutSizeChanged">
        <Grid x:Name="WorkbenchGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition x:Name="PrimaryWorkbenchRow" Height="*" />
                <RowDefinition x:Name="NarrowPaneDividerRow" Height="0" />
                <RowDefinition x:Name="ResponseWorkbenchRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaneColumn" Width="300" />
                <ColumnDefinition x:Name="LeftSplitterColumn" Width="18" />
                <ColumnDefinition x:Name="CenterPaneColumn" Width="760" />
                <ColumnDefinition x:Name="RightSplitterColumn" Width="18" />
                <ColumnDefinition x:Name="RightPaneColumn" Width="420" />
            </Grid.ColumnDefinitions>

            <Border x:Name="LeftRailScrim" Grid.RowSpan="4" Grid.ColumnSpan="5" Background="{ThemeResource ShellOverlayBrush}" Tapped="LeftRailScrimTapped" Visibility="Collapsed" />

            <Border x:Name="LeftPaneHost" Grid.RowSpan="4" Grid.Column="0" Margin="12" Background="{ThemeResource ShellPanelBrush}" CornerRadius="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Padding="20" Spacing="6">
                        <TextBlock FontFamily="{ThemeResource ShellDisplayFontFamily}" FontSize="28" FontWeight="SemiBold" Text="For-Rest" />
                        <TextBlock Foreground="{ThemeResource ShellMutedTextBrush}" Text="Clean shell pass one." />
                    </StackPanel>

                    <ComboBox Grid.Row="1" Margin="20,0,20,12" DisplayMemberPath="Name" ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace, Mode=TwoWay}" SelectionChanged="WorkspaceSelectionChanged" Style="{StaticResource WorkbenchComboBoxStyle}" />

                    <Grid Grid.Row="2" Margin="20,0,20,12" ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button x:Name="ExplorerRailButton" Grid.Column="0" Command="{Binding ShowExplorerRailCommand}" Content="Explorer" Style="{StaticResource WorkbenchSecondaryButtonStyle}" />
                        <Button x:Name="HistoryRailButton" Grid.Column="1" Command="{Binding ShowHistoryRailCommand}" Content="{Binding HistorySectionLabel}" Style="{StaticResource WorkbenchSecondaryButtonStyle}" />
                    </Grid>

                    <Border x:Name="ExplorerFilterBoxHost" Grid.Row="3" Margin="12" Background="{ThemeResource ShellPanelAltBrush}" CornerRadius="18">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBox x:Name="ExplorerFilterBox" Margin="12" PlaceholderText="Filter requests or history" Style="{StaticResource WorkbenchTextBoxStyle}" Text="{Binding ExplorerFilter, Mode=TwoWay}" />
                            <ListView x:Name="ExplorerList" Grid.Row="1" Margin="12,0,12,12" Background="Transparent" BorderThickness="0" IsItemClickEnabled="True" ItemClick="ExplorerItemClick" ItemsSource="{Binding ExplorerRows}" SelectionMode="None" />
                            <ListView x:Name="HistoryList" Grid.Row="1" Margin="12,0,12,12" Background="Transparent" BorderThickness="0" IsItemClickEnabled="True" ItemClick="HistoryItemClick" ItemsSource="{Binding HistoryRuns}" SelectionMode="None" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4" Margin="20,0,20,20" ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource WorkbenchMetaLabelStyle}" Text="OPEN" />
                        <TextBlock Grid.Column="1" Style="{StaticResource WorkbenchInfoValueStyle}" Text="{Binding OpenRequests.Count}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource WorkbenchMetaLabelStyle}" Text="RUNS" />
                        <TextBlock Grid.Column="3" Style="{StaticResource WorkbenchInfoValueStyle}" Text="{Binding HistoryRuns.Count}" />
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="LeftSplitterHost" Grid.RowSpan="4" Grid.Column="1">
                <Border x:Name="LeftSplitterRail" Width="6" HorizontalAlignment="Center" Background="{ThemeResource ShellHoverBrush}" CornerRadius="999" Opacity="0.36" />
                <Border x:Name="LeftSplitterGrip" Width="6" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{ThemeResource ShellAccentBrush}" CornerRadius="999" Opacity="0.52" />
                <primitives:Thumb x:Name="LeftPaneThumb" Width="18" Background="Transparent" DragStarted="LeftPaneThumbDragStarted" DragDelta="LeftPaneThumbDragDelta" DragCompleted="LeftPaneThumbDragCompleted" PointerEntered="OnSplitterPointerEntered" PointerExited="OnSplitterPointerExited" />
            </Grid>

            <Border x:Name="ShellTopStrip" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,12,12,8" Padding="18,10,160,10" Background="{ThemeResource ShellPanelAltBrush}" CornerRadius="22">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border x:Name="TitleBarDragRegion" Background="{ThemeResource ShellPanelBrush}" CornerRadius="16" Padding="16,12">
                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="Address Bar Lane" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource ShellMutedTextBrush}" Text="Reserved space across the middle and right panes." />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="10,6" Background="{ThemeResource ShellPanelBrush}" CornerRadius="999">
                        <TextBlock FontFamily="{ThemeResource CodeFontFamily}" FontSize="11" Foreground="{ThemeResource ShellMutedTextBrush}" Text="{Binding SelectedEnvironment.Name}" />
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="RequestPaneHost" Grid.Row="1" Grid.Column="2" Margin="0,0,0,12" Background="{ThemeResource ShellPanelBrush}" CornerRadius="22">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="20,20,20,14" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="LeftRailToggleButton" Grid.Column="0" Command="{Binding ToggleLeftRailCommand}" Style="{StaticResource WorkbenchToolbarButtonStyle}"><Button.Content><FontIcon Glyph="&#xE700;" /></Button.Content></Button>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2">
                            <TextBlock FontFamily="{ThemeResource ShellDisplayFontFamily}" FontSize="20" FontWeight="SemiBold" Text="Compose" />
                            <TextBlock Foreground="{ThemeResource ShellMutedTextBrush}" Text="Three-pane drafting canvas." />
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding SaveCommand}" Content="Save" Style="{StaticResource WorkbenchSecondaryButtonStyle}" />
                        <Button Grid.Column="3" Command="{Binding SendCommand}" Content="Send" Style="{StaticResource WorkbenchPrimaryButtonStyle}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Padding="20,0,20,20" Spacing="16">
                            <TextBox Header="Request URL" Style="{StaticResource WorkbenchTextBoxStyle}" Text="{Binding SelectedRequest.Url, Mode=TwoWay}" />
                            <TextBox Header="Request Body" Height="380" FontSize="{Binding EditorFontSize}" Style="{StaticResource WorkbenchCodeTextBoxStyle}" Text="{Binding SelectedRequest.BodyContent, Mode=TwoWay}" />
                            <TextBlock Foreground="{ThemeResource ShellMutedTextBrush}" Text="This pane is intentionally reduced so we can layer the request UX back in deliberately." TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid x:Name="RightSplitterHost" Grid.RowSpan="4" Grid.Column="3">
                <Border x:Name="RightSplitterRail" Width="6" HorizontalAlignment="Center" Background="{ThemeResource ShellHoverBrush}" CornerRadius="999" Opacity="0.36" />
                <Border x:Name="RightSplitterGrip" Width="6" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{ThemeResource ShellAccentBrush}" CornerRadius="999" Opacity="0.52" />
                <primitives:Thumb x:Name="RightPaneThumb" Width="18" Background="Transparent" DragStarted="RightPaneThumbDragStarted" DragDelta="RightPaneThumbDragDelta" DragCompleted="RightPaneThumbDragCompleted" PointerEntered="OnSplitterPointerEntered" PointerExited="OnSplitterPointerExited" />
            </Grid>

            <Border x:Name="ResponsePaneHost" Grid.Row="1" Grid.Column="4" Margin="0,0,12,12" Background="{ThemeResource ShellPanelBrush}" CornerRadius="22">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Margin="20,20,20,14" Spacing="2">
                        <TextBlock FontFamily="{ThemeResource ShellDisplayFontFamily}" FontSize="20" FontWeight="SemiBold" Text="Inspect" />
                        <TextBlock Foreground="{ThemeResource ShellMutedTextBrush}" Text="{Binding ResponseSummary}" />
                    </StackPanel>
                    <TabView Grid.Row="1" IsAddTabButtonVisible="False" Style="{StaticResource WorkbenchSectionTabViewStyle}">
                        <TabViewItem Header="Body" IsClosable="False"><TextBox FontSize="{Binding EditorFontSize}" IsReadOnly="True" Style="{StaticResource WorkbenchCodeTextBoxStyle}" Text="{Binding ResponseBody, Mode=OneWay}" /></TabViewItem>
                        <TabViewItem Header="Headers" IsClosable="False"><TextBox FontSize="{Binding EditorFontSize}" IsReadOnly="True" Style="{StaticResource WorkbenchCodeTextBoxStyle}" Text="{Binding ResponseHeaders, Mode=OneWay}" /></TabViewItem>
                        <TabViewItem Header="Raw" IsClosable="False"><TextBox FontSize="{Binding EditorFontSize}" IsReadOnly="True" Style="{StaticResource WorkbenchCodeTextBoxStyle}" Text="{Binding ResponseRaw, Mode=OneWay}" /></TabViewItem>
                    </TabView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
