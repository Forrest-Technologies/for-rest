<Application
    x:Class="ForRest.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <FontFamily x:Key="ShellFontFamily">Segoe UI Variable Text</FontFamily>
        <FontFamily x:Key="ShellDisplayFontFamily">Segoe UI Variable Display</FontFamily>
        <FontFamily x:Key="CodeFontFamily">Cascadia Code</FontFamily>
        <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#0C1016" />
        <SolidColorBrush x:Key="ShellPanelBrush" Color="#141A23" />
        <SolidColorBrush x:Key="ShellPanelAltBrush" Color="#10161E" />
        <SolidColorBrush x:Key="ShellRaisedBrush" Color="#1C2532" />
        <SolidColorBrush x:Key="ShellBorderBrush" Color="#2A3546" />
        <SolidColorBrush x:Key="ShellChromeBrush" Color="#090D13" />
        <SolidColorBrush x:Key="ShellCodeSurfaceBrush" Color="#0A0F15" />
        <SolidColorBrush x:Key="ShellInputBrush" Color="#0F151D" />
        <SolidColorBrush x:Key="ShellHairlineBrush" Color="#223043" />
        <SolidColorBrush x:Key="ShellAccentBrush" Color="#4F90FF" />
        <SolidColorBrush x:Key="ShellAccentSoftBrush" Color="#163A67" />
        <SolidColorBrush x:Key="ShellSelectionBrush" Color="#273347" />
        <SolidColorBrush x:Key="ShellSuccessBrush" Color="#23A55A" />
        <SolidColorBrush x:Key="ShellWarningBrush" Color="#D29922" />
        <SolidColorBrush x:Key="ShellErrorBrush" Color="#D73A49" />
        <SolidColorBrush x:Key="ShellMutedTextBrush" Color="#9AA4B2" />
        <SolidColorBrush x:Key="ShellTextBrush" Color="#F3F6FA" />
        <SolidColorBrush x:Key="MethodGetBrush" Color="#1A7F64" />
        <SolidColorBrush x:Key="MethodPostBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="MethodPutBrush" Color="#7C3AED" />
        <SolidColorBrush x:Key="MethodPatchBrush" Color="#C2410C" />
        <SolidColorBrush x:Key="MethodDeleteBrush" Color="#B42318" />
        <SolidColorBrush x:Key="MethodHeadBrush" Color="#475467" />
        <SolidColorBrush x:Key="MethodOptionsBrush" Color="#155EEF" />

        <Style x:Key="WorkbenchPaneTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource ShellDisplayFontFamily}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource ShellTextBrush}" />
        </Style>

        <Style x:Key="WorkbenchMetaLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource CodeFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource ShellMutedTextBrush}" />
            <Setter Property="CharacterSpacing" Value="80" />
        </Style>

        <Style x:Key="WorkbenchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{ThemeResource ShellInputBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ShellHairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{ThemeResource ShellTextBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="WorkbenchCodeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource WorkbenchTextBoxStyle}">
            <Setter Property="Background" Value="{ThemeResource ShellCodeSurfaceBrush}" />
            <Setter Property="FontFamily" Value="{ThemeResource CodeFontFamily}" />
        </Style>

        <Style x:Key="WorkbenchComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{ThemeResource ShellInputBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ShellHairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{ThemeResource ShellTextBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="WorkbenchPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource ShellAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="MinWidth" Value="90" />
        </Style>

        <Style x:Key="WorkbenchSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource ShellRaisedBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource ShellTextBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ShellHairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
    </Application.Resources>
</Application>
