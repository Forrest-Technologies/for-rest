## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Repository-local state and secret material
/.azure/
/.claude/worktrees/
/.codex/
/.codex-dotnet/
/.dotnet-cli/
/.dotnet-home/
/.vs/
/.local/
/build/android/
/config/settings.toml
/config/license-admin.local.json
/config/license-issued-history.local.json
/docs/local/
/.env
/.env.*
*.keystore
*.jks
*.p12
*.pfx
*.snk
secrets.json
local.settings.json

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
*.user
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml
/.dotnet-cli/.dotnet
*/*.Log
*.log
*.vs
*.bin
*.obj
*/*.bin
*.cache
/.codex-tools
